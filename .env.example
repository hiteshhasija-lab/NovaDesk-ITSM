# NovaDesk settings for compose.yaml. Copy to .env and fill in; never commit .env.
# Generate each secret with:  openssl rand -hex 32   (hex only, so nothing needs quoting)

# ---- Required -------------------------------------------------------------------------------

NODE_ENV=production

# Database (the postgres service is created with these on first start)
PGUSER=novadesk
PGPASSWORD=
PGDATABASE=novadesk

# Signs session cookies. At least 32 characters.
SESSION_SECRET=

# The first admin account, created on first start when the database is empty (ignored after that;
# change the password in the app). ADMIN_PASSWORD at least 10 characters (PASSWORD_MIN_LENGTH) and not a common password.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_FULL_NAME=Administrator
ADMIN_EMAIL=

# ---- Optional -------------------------------------------------------------------------------

# Listen on this one server address only, for a server with several IPs (default: all of them).
#NOVADESK_BIND_IP=

# Host ports for the web app (inside the container it listens on 8080 http / 8443 https).
# Rootless Podman needs net.ipv4.ip_unprivileged_port_start=0 to bind ports below 1024.
# Running next to NovaConnect on the same server: give each its own address (BIND_IP) or ports.
NOVADESK_HTTP_PORT=80
NOVADESK_HTTPS_PORT=443

# A demonstration workspace with sample users (admin/admin123, jdoe/agent123, ...) instead of ADMIN_*,
# on an empty database only. For demos and testing; never on a real install.
SEED_DEMO=false

# ---- Single sign-on and two-step verification --------------------------------------------------
# Single sign-on with OpenID Connect (Microsoft Entra ID, Google Workspace, Okta, Keycloak, ...). Set all four, or none.
# PUBLIC_URL is the address people type to reach NovaDesk; register PUBLIC_URL/auth/oidc/callback as the
# redirect address at your provider.
#PUBLIC_URL=https://helpdesk.example.com
#OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_BUTTON_LABEL=Sign in with Microsoft
# Create an account the first time someone signs in (role user or agent, never admin). Default: only
# people who already have an account can sign in, matched by their verified email.
#OIDC_AUTO_CREATE=false
#OIDC_DEFAULT_ROLE=user
# Only these email domains may sign in (comma separated). Empty: any.
#OIDC_ALLOWED_DOMAINS=example.com
# Microsoft Entra ID does not say that an email is verified. true matches accounts by email anyway: use it
# only with an issuer that is your own tenant.
#OIDC_TRUST_EMAIL=false
# false hides the username and password form (single sign-on above must be set up).
#LOCAL_LOGIN=true
# Two-step verification (one-time codes from an authenticator app) is optional for everyone, under the user menu.
# MFA_REQUIRE makes it compulsory for administrators (admins) or everybody who signs in with a password (all).
#MFA_REQUIRE=none
# Encrypts the stored two-step secrets. Default: derived from SESSION_SECRET. Set your own to be able to
# change SESSION_SECRET without losing them.
#MFA_ENCRYPTION_KEY=

# ---- Passwords and lockout -------------------------------------------------------------------
# Shortest password accepted (8-64, default 10). Common passwords, a password that is one repeated character and
# a password containing the person's own name or user name are refused whatever the length.
#PASSWORD_MIN_LENGTH=10
# An account is locked for LOCKOUT_MINUTES after this many wrong passwords in a row (0 = never lock; default 10).
# An administrator can unlock it from the user's page. Locked accounts get the same "wrong user name or
# password" answer, so the lock does not reveal which user names exist.
#LOCKOUT_AFTER=10
#LOCKOUT_MINUTES=15
# Failed sign-ins allowed per address in 15 minutes before the sign-in page answers 429 (0 = no limit; default 20).
#RATE_LIMIT_LOGIN_FAILURES=20

# ---- Behind a reverse proxy, and rate limits -------------------------------------------------
# If a reverse proxy or load balancer sits in front of NovaDesk, say how many: NovaDesk then reads each person's
# address from X-Forwarded-For (used by the rate limits and the sign-in throttle) instead of seeing the proxy's.
# Use the number of proxies (1), or loopback / the proxy's address. Never "true".
#TRUST_PROXY=1
# Requests per minute (0 = no limit): every page and API route per address; the REST API per key for reads
# and for writes. See "REST API" in the README.
#RATE_LIMIT_IP_PER_MIN=1200
#RATE_LIMIT_API_PER_MIN=300
#RATE_LIMIT_API_WRITE_PER_MIN=60

# ---- Webhooks ---------------------------------------------------------------------------------
# Webhooks (user menu, Webhooks) call an address of yours when records change. By default only https:// addresses
# that resolve to public addresses are accepted, so a webhook cannot be pointed at this server's own network.
# true also allows private/local addresses and plain http, for a receiver inside your network.
#WEBHOOK_ALLOW_PRIVATE=false
# A receiver whose last N deliveries all failed is switched off (default 10).
#WEBHOOK_AUTO_DISABLE_AFTER=10

# ---- NovaConnect (chat-driven decommissioning) -----------------------------------------------
# Leave these empty to run NovaDesk on its own. To link it to NovaConnect set all three, with the SAME
# SYNC_API_KEY on both sides (NovaConnect: SYNC_API_KEY, NOVADESK_BASE_URL, NOVADESK_PUBLIC_URL).
# Where NovaConnect can be reached from this server, e.g. http://10.0.0.102 (no default on purpose).
#NOVACONNECT_BASE_URL=
# Shared secret for the integration endpoints.
#SYNC_API_KEY=

# ---- Email ------------------------------------------------------------------------------------
# NovaDesk emails people about their tickets (assigned, commented, approved, ...). Without SMTP_HOST
# nothing is sent: notices are still listed under Notifications, marked "Not sent". After setting
# these, restart NovaDesk and use "Send a test email to me" on the Notifications page (administrators).
#SMTP_HOST=smtp.example.com
# 587 = STARTTLS (default), 465 = TLS from the first byte (also set SMTP_SECURE=true), 25 = plain relay.
#SMTP_PORT=587
#SMTP_SECURE=false
# The sender address people see. Use an address your mail service lets you send from.
#SMTP_FROM=NovaDesk <helpdesk@example.com>
# The sign-in for the mail server (both, or neither for a relay that needs none). With a sign-in the
# connection must be encrypted; NovaDesk refuses to send the password in clear text.
#SMTP_USER=
#SMTP_PASSWORD=
# Set to false only if your mail server uses a certificate your server does not trust (self-signed).
#SMTP_TLS_VERIFY=true

# ---- ESXi (decommission automation) ----------------------------------------------------------
# An account on your ESXi hosts that may power off and destroy virtual machines. Without it the
# automation stops at the power-off step and says so.
#ESXI_USER=
#ESXI_PASSWORD=
# Hours between power-off and Confirm Destroy (default 24).
#DECOM_SOAK_PERIOD_HOURS=24
