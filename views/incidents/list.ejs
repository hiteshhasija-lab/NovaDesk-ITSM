<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">
      <i class="bi bi-exclamation-triangle text-primary me-1"></i>Incidents
      <% if (filters.sla === 'breached') { %>
        <span class="badge bg-danger align-middle">SLA Breached</span>
        <a href="/incidents" class="small ms-1">clear</a>
      <% } else if (filters.sla === 'at_risk') { %>
        <span class="badge bg-warning align-middle">SLA At Risk</span>
        <a href="/incidents" class="small ms-1">clear</a>
      <% } else if (filters.sla) { %>
        <span class="badge bg-secondary align-middle">SLA Filtered</span>
        <a href="/incidents" class="small ms-1">clear</a>
      <% } else if (filters.status === 'open') { %>
        <span class="badge bg-primary align-middle">Open Only</span>
        <a href="/incidents" class="small ms-1">clear</a>
      <% } %>
    </h4>
    <div class="d-flex align-items-center gap-2">
      <% if (currentUser.role !== 'user') { %>
      <div class="btn-group view-toggle" role="group">
        <a href="/incidents" class="btn btn-sm btn-secondary"><i class="bi bi-list-ul"></i> List</a>
        <a href="/incidents/board" class="btn btn-sm btn-outline-secondary"><i class="bi bi-kanban"></i> Board</a>
      </div>
      <% } %>
      <% if (currentUser.role !== 'user') { %>
      <a href="/incidents/export.csv" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download"></i> Export CSV</a>
      <% } %>
      <a href="/incidents/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> New Incident</a>
    </div>
  </div>

  <form class="row g-2 mb-3" id="incidentFilterForm" method="GET">
    <div class="col-md-3">
      <input type="text" id="incidentLiveSearch" name="q" value="<%= filters.q || '' %>" class="form-control form-control-sm" placeholder="Search number, description, or CI..." autocomplete="off">
    </div>
    <div class="col-md-2">
      <select name="priority" class="form-select form-select-sm auto-filter">
        <option value="">All priorities</option>
        <% [1,2,3,4].forEach(p => { %>
          <option value="<%= p %>" <%= String(filters.priority) === String(p) ? 'selected' : '' %>>P<%= p %> - <%= h.PRIORITY_LABELS[p] %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <select name="status" class="form-select form-select-sm auto-filter">
        <option value="">All statuses</option>
        <option value="open" <%= filters.status === 'open' ? 'selected' : '' %>>Open (New/In Progress/On Hold)</option>
        <% ['new','in_progress','on_hold','resolved','closed','cancelled'].forEach(s => { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= h.INCIDENT_STATUS_LABELS[s] %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <select name="sla" class="form-select form-select-sm auto-filter">
        <option value="">All SLA states</option>
        <option value="breached" <%= filters.sla === 'breached' ? 'selected' : '' %>>Breached</option>
        <option value="at_risk" <%= filters.sla === 'at_risk' ? 'selected' : '' %>>At Risk</option>
        <option value="on_track" <%= filters.sla === 'on_track' ? 'selected' : '' %>>On Track</option>
        <option value="met" <%= filters.sla === 'met' ? 'selected' : '' %>>Met SLA</option>
      </select>
    </div>
    <div class="col-md-2">
      <select name="assigned_to" class="form-select form-select-sm auto-filter">
        <option value="">Assigned to anyone</option>
        <option value="unassigned" <%= filters.assigned_to === 'unassigned' ? 'selected' : '' %>>Unassigned</option>
        <% assignableUsers.forEach(u => { %>
          <option value="<%= u.id %>" <%= String(filters.assigned_to) === String(u.id) ? 'selected' : '' %>><%= u.full_name %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-1">
      <button class="btn btn-sm btn-outline-secondary w-100" type="submit">Go</button>
    </div>
  </form>

  <% if (currentUser.role !== 'user') { %>
  <div id="bulkToolbar" class="card mb-3 border-primary" hidden>
    <div class="card-body d-flex align-items-center gap-2 flex-wrap">
      <span class="fw-semibold small"><span id="bulkCount">0</span> selected</span>
      <select id="bulkStatus" class="form-select form-select-sm" style="max-width:180px;">
        <option value="">Set status...</option>
        <% ['new','in_progress','on_hold','resolved','closed','cancelled'].forEach(s => { %>
          <option value="<%= s %>"><%= h.INCIDENT_STATUS_LABELS[s] %></option>
        <% }) %>
      </select>
      <select id="bulkAssignee" class="form-select form-select-sm" style="max-width:200px;">
        <option value="">Reassign to...</option>
        <option value="__unassign__">Unassigned</option>
        <% staffUsers.forEach(u => { %>
          <option value="<%= u.id %>"><%= u.full_name %></option>
        <% }) %>
      </select>
      <button id="bulkApply" class="btn btn-sm btn-primary"><i class="bi bi-check-lg"></i> Apply</button>
      <button id="bulkClear" class="btn btn-sm btn-outline-secondary">Clear selection</button>
    </div>
  </div>
  <% } %>

  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <% if (currentUser.role !== 'user') { %><th style="width:2rem;"><input type="checkbox" id="selectAll" class="form-check-input"></th><% } %>
            <th>Number</th><th>Short Description</th><th>Priority</th><th>Status</th><th>SLA</th>
            <th>Caller</th><th>Assigned To</th><th>Affected CI</th><th>Created</th>
          </tr>
        </thead>
        <tbody id="incidentsTableBody">
          <% if (incidents.length === 0) { %>
            <tr><td colspan="10" class="text-center text-muted py-4">No incidents found.</td></tr>
          <% } %>
          <% incidents.forEach(inc => { %>
          <% const sla = h.slaStatus(inc); %>
          <tr onclick="window.location='/incidents/<%= inc.id %>'" data-search="<%= [inc.number, inc.short_description, inc.ci_name].filter(Boolean).join(' ').toLowerCase() %>">
            <% if (currentUser.role !== 'user') { %>
            <td onclick="event.stopPropagation()"><input type="checkbox" class="form-check-input row-check" value="<%= inc.id %>"></td>
            <% } %>
            <td class="fw-semibold"><%= inc.number %></td>
            <td><%= inc.short_description %></td>
            <td><span class="badge bg-<%= h.PRIORITY_BADGE[inc.priority] %>">P<%= inc.priority %> · <%= h.PRIORITY_LABELS[inc.priority] %></span></td>
            <td><span class="badge bg-<%= h.INCIDENT_STATUS_BADGE[inc.status] %>"><%= h.INCIDENT_STATUS_LABELS[inc.status] %></span></td>
            <td>
              <span class="badge bg-<%= sla.badge %>"><%= sla.label %></span>
              <% if (sla.key === 'on_track' || sla.key === 'at_risk') { %>
                <div class="small text-muted"><%= h.fmtDateShort(inc.sla_due_at) %></div>
              <% } %>
            </td>
            <td><%= inc.caller_name || '—' %></td>
            <td><%= inc.assigned_name || '—' %></td>
            <td><%= inc.ci_name || '—' %></td>
            <td class="small text-muted"><%= h.fmtDateShort(inc.created_at) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <div id="incidentsNoLiveResults" class="text-center text-muted py-4" hidden>No incidents match "<span id="incidentsNoLiveResultsQuery"></span>".</div>
    </div>
  </div>
</div>

<script>
  (function () {
    var input = document.getElementById('incidentLiveSearch');
    var rows = Array.prototype.slice.call(document.querySelectorAll('#incidentsTableBody tr[data-search]'));
    var noResults = document.getElementById('incidentsNoLiveResults');
    var noResultsQuery = document.getElementById('incidentsNoLiveResultsQuery');
    if (!input || rows.length === 0) return;

    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      var visibleCount = 0;
      rows.forEach(function (row) {
        var match = !q || row.getAttribute('data-search').indexOf(q) !== -1;
        row.hidden = !match;
        if (match) visibleCount++;
      });
      noResults.hidden = !(q && visibleCount === 0);
      noResultsQuery.textContent = input.value.trim();
    });
  })();

  document.querySelectorAll('#incidentFilterForm .auto-filter').forEach(function (el) {
    el.addEventListener('change', function () { el.form.submit(); });
  });
</script>

<% if (currentUser.role !== 'user') { %>
<script>
  (function () {
    const toolbar = document.getElementById('bulkToolbar');
    const countEl = document.getElementById('bulkCount');
    const selectAll = document.getElementById('selectAll');
    const checks = () => Array.from(document.querySelectorAll('.row-check'));

    function refresh() {
      const selected = checks().filter(c => c.checked);
      countEl.textContent = selected.length;
      toolbar.hidden = selected.length === 0;
    }

    selectAll.addEventListener('change', function () {
      checks().forEach(c => { c.checked = selectAll.checked; });
      refresh();
    });
    checks().forEach(c => c.addEventListener('change', refresh));

    document.getElementById('bulkClear').addEventListener('click', function () {
      checks().forEach(c => { c.checked = false; });
      selectAll.checked = false;
      refresh();
    });

    document.getElementById('bulkApply').addEventListener('click', function () {
      const ids = checks().filter(c => c.checked).map(c => Number(c.value));
      const status = document.getElementById('bulkStatus').value;
      const assigneeRaw = document.getElementById('bulkAssignee').value;
      if (ids.length === 0) return;
      if (!status && !assigneeRaw) { alert('Choose a status or assignee to apply.'); return; }

      const body = { ids };
      if (status) body.status = status;
      if (assigneeRaw) body.assigned_to = assigneeRaw === '__unassign__' ? null : Number(assigneeRaw);

      fetch('/incidents/bulk-update', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      }).then(r => r.json()).then(function (res) {
        if (res.ok) { location.reload(); } else { alert(res.error || 'Something went wrong.'); }
      }).catch(() => alert('Network error.'));
    });
  })();
</script>
<% } %>
<%- include('../partials/foot') %>
