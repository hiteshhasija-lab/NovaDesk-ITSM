<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">
      <i class="bi bi-search text-info me-1"></i>Problems
      <% if (filters.status === 'open') { %>
        <span class="badge bg-secondary align-middle">Open Only</span>
        <a href="/problems" class="small ms-1">clear</a>
      <% } %>
    </h4>
    <div class="d-flex gap-2">
      <a href="/problems/export.csv<%- h.withQuery(query, { page: null }) %>" id="exportCsvBtn" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download"></i> Export CSV</a>
      <a href="/problems/new" class="btn btn-info btn-sm text-white"><i class="bi bi-plus-lg"></i> New Problem</a>
    </div>
  </div>

  <form class="row g-2 mb-3" id="problemsFilterForm" method="GET">
    <div class="col-md-3">
      <input type="text" id="problemsLiveSearch" name="q" value="<%= filters.q || '' %>" class="form-control form-control-sm" placeholder="Search number, description, or CI..." autocomplete="off">
    </div>
    <div class="col-md-2">
      <select name="priority" class="form-select form-select-sm auto-filter">
        <option value="">All priorities</option>
        <% [1,2,3,4].forEach(p => { %>
          <option value="<%= p %>" <%= String(filters.priority) === String(p) ? 'selected' : '' %>>P<%= p %> - <%= h.PRIORITY_LABELS[p] %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <select name="status" class="form-select form-select-sm auto-filter">
        <option value="">All statuses</option>
        <option value="open" <%= filters.status === 'open' ? 'selected' : '' %>>Open (Not Resolved/Closed)</option>
        <% ['new','investigating','known_error','resolved','closed'].forEach(s => { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= h.PROBLEM_STATUS_LABELS[s] %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-3">
      <select name="assigned_to" class="form-select form-select-sm auto-filter">
        <option value="">Assigned to anyone</option>
        <option value="unassigned" <%= filters.assigned_to === 'unassigned' ? 'selected' : '' %>>Unassigned</option>
        <% assignableUsers.forEach(u => { %>
          <option value="<%= u.id %>" <%= String(filters.assigned_to) === String(u.id) ? 'selected' : '' %>><%= u.full_name %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <button class="btn btn-sm btn-outline-secondary w-100" type="submit">Go</button>
    </div>
  </form>

  <%
    function sortHeader(col, label) {
      const active = sort.key === col;
      const nextDir = active && sort.dir === 'asc' ? 'desc' : 'asc';
      const icon = active ? (sort.dir === 'asc' ? 'bi-caret-up-fill' : 'bi-caret-down-fill') : 'bi-caret-down text-muted opacity-25';
      return `<a href="${h.withQuery(query, { sort: col, dir: nextDir, page: 1 })}" class="text-decoration-none text-reset">${label} <i class="bi ${icon} small"></i></a>`;
    }
  %>
  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th><%- sortHeader('number', 'Number') %></th><th>Short Description</th><th><%- sortHeader('priority', 'Priority') %></th><th><%- sortHeader('status', 'Status') %></th>
            <th>Assigned To</th><th>Affected CI</th><th>Linked Incidents</th><th><%- sortHeader('created_at', 'Created') %></th>
          </tr>
        </thead>
        <tbody id="problemsTableBody">
          <% if (problems.length === 0) { %>
            <tr><td colspan="8" class="text-center text-muted py-4">No problems found.</td></tr>
          <% } %>
          <% problems.forEach(p => { %>
          <tr onclick="window.location='/problems/<%= p.id %>'" data-search="<%= [p.number, p.short_description, p.ci_name].filter(Boolean).join(' ').toLowerCase() %>">
            <td class="fw-semibold"><%= p.number %></td>
            <td><%= p.short_description %></td>
            <td><span class="badge bg-<%= h.PRIORITY_BADGE[p.priority] %>">P<%= p.priority %> · <%= h.PRIORITY_LABELS[p.priority] %></span></td>
            <td><span class="badge bg-<%= h.PROBLEM_STATUS_BADGE[p.status] %>"><%= h.PROBLEM_STATUS_LABELS[p.status] %></span></td>
            <td><%= p.assigned_name || 'Unassigned' %></td>
            <td><%= p.ci_name || '—' %></td>
            <td><span class="badge bg-secondary"><%= p.incident_count %></span></td>
            <td class="small text-muted"><%- h.fmtDateShort(p.created_at) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
  <%- include('../partials/pagination', { pagination, query }) %>
</div>

<script>
  document.querySelectorAll('#problemsFilterForm .auto-filter').forEach(function (el) {
    el.addEventListener('change', function () { el.form.submit(); });
  });

  (function () {
    var input = document.getElementById('problemsLiveSearch');
    var form = document.getElementById('problemsFilterForm');
    var exportBtn = document.getElementById('exportCsvBtn');
    if (!input) return;

    if (exportBtn) {
      var baseHref = exportBtn.getAttribute('href').split('?')[0];
      var updateHref = function () {
        var params = new URLSearchParams(window.location.search);
        var q = input.value.trim();
        if (q) { params.set('q', q); } else { params.delete('q'); }
        params.delete('page');
        var qs = params.toString();
        exportBtn.setAttribute('href', baseHref + (qs ? '?' + qs : ''));
      };
      input.addEventListener('input', updateHref);
    }

    // Debounced auto-submit — searches the full dataset server-side (every page, not just the
    // rows already rendered on this one), instead of the old behavior of hiding/showing
    // already-rendered rows client-side, which silently missed matches sitting on another page.
    if (form) {
      var searchTimer = null;
      input.addEventListener('input', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(function () { form.submit(); }, 400);
      });
    }
  })();
</script>
<%- include('../partials/foot') %>
