<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4" style="max-width: 1100px;">
  <h4 class="mb-2"><i class="bi bi-shield-check text-primary me-1"></i>Privacy</h4>
  <p class="text-muted small">See everything <%= brand.name %> holds about a person and download it, anonymise a person who has left or asked to be forgotten, and decide how long logs and messages are kept. Each of these is recorded in the audit log.</p>

  <% if (notice) { %><div class="alert alert-success py-2 small"><%= notice %></div><% } %>

  <div class="card mb-3"><div class="card-body">
    <h6 class="section-title">Find a person</h6>
    <form method="GET" action="/privacy" class="row g-2 mb-2">
      <div class="col-md-6"><label class="form-label small visually-hidden" for="privacy_q">Name, username or email</label>
        <input class="form-control form-control-sm" id="privacy_q" name="q" value="<%= q %>" placeholder="Name, username or email" maxlength="100"></div>
      <div class="col-md-2"><button class="btn btn-sm btn-primary w-100" type="submit">Search</button></div>
    </form>
    <% if (people) { %>
      <% if (!people.length) { %><p class="small text-muted mb-0">Nobody matches.</p><% } else { %>
      <div class="table-responsive"><table class="table table-sm table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Name</th><th>Username</th><th>Email</th><th>Role</th><th></th></tr></thead>
        <tbody><% people.forEach(u => { %>
          <tr>
            <td><%= u.full_name %><% if (u.anonymised_at) { %> <span class="badge bg-dark ms-1">anonymised</span><% } else if (!u.active) { %> <span class="badge bg-secondary ms-1">inactive</span><% } %></td>
            <td><%= u.username %></td><td><%= u.email || '—' %></td><td class="text-capitalize"><%= u.role %></td>
            <td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/privacy/person/<%= u.id %>">Open</a></td>
          </tr>
        <% }) %></tbody>
      </table></div>
      <% } %>
    <% } %>
  </div></div>

  <div class="card mb-3"><div class="card-body">
    <h6 class="section-title">How long to keep things</h6>
    <p class="small text-muted">Everything is kept for ever until you set a number of days. Once a day <%= brand.name %> removes what is older than the limit. The shortest limit is <%= min %> days. Tickets, comments and their history are never removed here.</p>
    <form method="POST" action="/privacy/retention">
      <div class="table-responsive"><table class="table table-sm align-middle mb-3">
        <thead class="table-light"><tr><th>Kept</th><th style="width:150px;">Days (empty = for ever)</th><th>Now</th><th>Last removal</th></tr></thead>
        <tbody>
        <% rules.forEach(r => { const v = values ? values[r.id] : (r.days || ''); %>
          <tr>
            <td><label class="fw-semibold" for="days_<%= r.id %>"><%= r.label %></label><div class="small text-muted"><%= r.help %></div></td>
            <td>
              <input class="form-control form-control-sm<%= errors[r.id] ? ' is-invalid' : '' %>" id="days_<%= r.id %>" name="days_<%= r.id %>" value="<%= v %>" inputmode="numeric" maxlength="4" placeholder="for ever">
              <% if (errors[r.id]) { %><div class="invalid-feedback"><%= errors[r.id] %></div><% } %>
            </td>
            <td class="small"><%= r.total %> held<% if (r.days) { %>, <strong><%= r.due %></strong> older than the limit<% } %></td>
            <td class="small text-muted"><% if (r.lastRunAt) { %><%- h.fmtDate(r.lastRunAt) %>: <%= r.lastRemoved === null ? '—' : r.lastRemoved %> removed<% } else { %>never<% } %></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
      <button type="submit" class="btn btn-sm btn-primary">Save limits</button>
    </form>
    <form method="POST" action="/privacy/retention/run" class="mt-2" data-confirm="Remove everything past its limit now? Removed records cannot be brought back.">
      <button type="submit" class="btn btn-sm btn-outline-danger">Run now</button>
      <span class="small text-muted ms-2">Does today's removal straight away instead of waiting for the daily run.</span>
    </form>
  </div></div>

  <div class="card mb-3"><div class="card-body" id="inactive">
    <h6 class="section-title">Accounts that stay switched off</h6>
    <p class="small text-muted">An account that has been switched off (inactive on the Users page) keeps a person's name and details for as long as it exists. Set a number of days and <%= brand.name %> anonymises accounts that have been off for longer than that, once a day: the same as <em>Anonymise</em> on the person's page, with their comments and files kept. It cannot be undone. Accounts that are switched on are never touched, and switching an account on again starts the count afresh. Off until you set it; the shortest is <%= min %> days.</p>
    <form method="POST" action="/privacy/inactive" class="row g-2 align-items-end mb-2">
      <div class="col-sm-4 col-md-3">
        <label class="form-label small" for="inactive_days">Days switched off (empty = never)</label>
        <input class="form-control form-control-sm<%= inactiveError ? ' is-invalid' : '' %>" id="inactive_days" name="inactive_days" value="<%= inactiveValue !== null ? inactiveValue : (inactiveRule.days || '') %>" inputmode="numeric" maxlength="4" placeholder="never">
        <% if (inactiveError) { %><div class="invalid-feedback"><%= inactiveError %></div><% } %>
      </div>
      <div class="col-auto"><button type="submit" class="btn btn-sm btn-primary">Save</button></div>
    </form>
    <% if (inactiveRule.days) { %>
      <p class="small text-muted mb-2">Last run: <% if (inactiveRule.lastRunAt) { %><%- h.fmtDate(inactiveRule.lastRunAt) %>, <%= inactiveRule.lastCount === null ? '—' : inactiveRule.lastCount %> anonymised<% } else { %>never<% } %>.
        <strong><%= inactiveWaiting.due %></strong> account<%= inactiveWaiting.due === 1 ? ' is' : 's are' %> past the limit now.</p>
    <% } %>
    <% if (!inactiveWaiting.people.length) { %>
      <p class="small text-muted mb-0">Nobody is switched off at the moment.</p>
    <% } else { %>
      <div class="table-responsive"><table class="table table-sm align-middle small mb-2">
        <thead class="table-light"><tr><th>Person</th><th>Switched off</th><th><%= inactiveRule.days ? 'Anonymised on' : '' %></th></tr></thead>
        <tbody>
        <% inactiveWaiting.people.forEach(p => { %>
          <tr>
            <td><a href="/privacy/person/<%= p.id %>"><%= p.full_name %></a> <span class="text-muted"><%= p.username %></span></td>
            <td><%- h.fmtDate(p.deactivated_at) %></td>
            <td><% if (inactiveRule.days) { %><%= p.overdue ? 'next run' : p.on %><% } %></td>
          </tr>
        <% }) %>
        </tbody>
      </table></div>
      <% if (inactiveWaiting.total > inactiveWaiting.people.length) { %><p class="small text-muted">…and <%= inactiveWaiting.total - inactiveWaiting.people.length %> more.</p><% } %>
      <% if (inactiveRule.days) { %><p class="small text-muted mb-2">To keep someone, switch their account on again before the day (Users, then the person).</p><% } %>
    <% } %>
    <% if (inactiveRule.days) { %>
    <form method="POST" action="/privacy/inactive/run" class="mt-2" data-confirm="Anonymise every account that is past the limit now? This cannot be undone.">
      <button type="submit" class="btn btn-sm btn-outline-danger">Anonymise now</button>
      <span class="small text-muted ms-2">Does today's run straight away instead of waiting for it.</span>
    </form>
    <% } %>
  </div></div>

  <div class="card"><div class="card-body">
    <h6 class="section-title">Recent privacy actions</h6>
    <% if (!recent.length) { %><p class="small text-muted mb-0">Nothing yet.</p><% } else { %>
    <div class="table-responsive"><table class="table table-sm align-middle mb-0">
      <tbody><% recent.forEach(r => { %>
        <tr><td class="small text-muted text-nowrap"><%- h.fmtDate(r.at) %></td><td><code class="small"><%= r.action %></code></td><td class="small"><%= r.actor_name || '—' %></td><td class="small"><%= r.target_name || '' %></td><td class="small text-muted"><%= r.detail || '' %></td></tr>
      <% }) %></tbody>
    </table></div>
    <% } %>
  </div></div>
</div>
<%- include('../partials/foot') %>
