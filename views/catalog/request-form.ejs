<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <h4 class="mb-3"><i class="bi <%= item.icon %> text-primary me-1"></i>Request: <%= item.name %></h4>
  <div class="card" style="max-width:600px;">
    <div class="card-body">
      <p class="text-muted"><%= item.description %></p>
      <% if (item.fulfillment_group) { %><p class="small text-muted">Fulfilled by <strong><%= item.fulfillment_group %></strong></p><% } %>
      <form method="POST" action="/catalog/<%= item.id %>/request">
        <div class="mb-3">
          <label class="form-label">Details / Justification</label>
          <textarea name="notes" class="form-control" rows="4" placeholder="Any details that will help fulfill this request (e.g. reason, urgency, specifics)."></textarea>
        </div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-send"></i> Submit Request</button>
        <a href="/catalog" class="btn btn-outline-secondary">Cancel</a>
      </form>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
