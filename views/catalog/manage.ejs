<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-gear text-primary me-1"></i>Manage Catalog</h4>
    <a href="/catalog" class="btn btn-sm btn-outline-secondary">&larr; Back to catalog</a>
  </div>

  <div class="row g-3">
    <div class="col-lg-8">
      <div class="card">
        <div class="table-responsive">
          <table class="table table-hover mb-0 align-middle">
            <thead class="table-light">
              <tr><th>Name</th><th>Category</th><th>Fulfillment Group</th><th>Status</th><th></th></tr>
            </thead>
            <tbody>
              <% items.forEach(item => { %>
              <tr>
                <td><i class="bi <%= item.icon %> me-1"></i><%= item.name %></td>
                <td class="text-capitalize"><%= item.category %></td>
                <td><%= item.fulfillment_group || '—' %></td>
                <td><span class="badge bg-<%= item.active ? 'success' : 'secondary' %>"><%= item.active ? 'Active' : 'Inactive' %></span></td>
                <td>
                  <form method="POST" action="/catalog/manage/<%= item.id %>/toggle">
                    <button type="submit" class="btn btn-sm btn-outline-secondary"><%= item.active ? 'Deactivate' : 'Activate' %></button>
                  </form>
                </td>
              </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
    <div class="col-lg-4">
      <div class="card">
        <div class="card-header fw-semibold">New Catalog Item</div>
        <div class="card-body">
          <form method="POST" action="/catalog/manage">
            <div class="mb-2">
              <label class="form-label small">Name</label>
              <input type="text" name="name" class="form-control form-control-sm" required>
            </div>
            <div class="mb-2">
              <label class="form-label small">Description</label>
              <textarea name="description" class="form-control form-control-sm" rows="2"></textarea>
            </div>
            <div class="mb-2">
              <label class="form-label small">Category</label>
              <select name="category" class="form-select form-select-sm">
                <% ['hardware','software','access','general'].forEach(c => { %><option value="<%= c %>"><%= c %></option><% }) %>
              </select>
            </div>
            <div class="mb-2">
              <label class="form-label small">Icon (Bootstrap Icon class)</label>
              <input type="text" name="icon" class="form-control form-control-sm" placeholder="bi-box-seam" value="bi-box-seam">
            </div>
            <div class="mb-2">
              <label class="form-label small">Fulfillment Group</label>
              <select name="fulfillment_group" class="form-select form-select-sm">
                <option value="">None</option>
                <% h.ASSIGNMENT_GROUPS.forEach(g => { %><option value="<%= g %>"><%= g %></option><% }) %>
              </select>
            </div>
            <button type="submit" class="btn btn-sm btn-primary w-100">Add Item</button>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
