<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-shop text-primary me-1"></i>Service Catalog</h4>
    <div class="d-flex gap-2">
      <a href="/requests" class="btn btn-sm btn-outline-secondary"><i class="bi bi-list-check"></i> My Requests</a>
      <% if (currentUser.role === 'admin') { %>
      <a href="/catalog/manage" class="btn btn-sm btn-outline-secondary"><i class="bi bi-gear"></i> Manage Catalog</a>
      <% } %>
    </div>
  </div>

  <div class="row g-3">
    <% items.forEach(item => { %>
      <div class="col-md-4 col-lg-3">
        <div class="card h-100 tile-card">
          <div class="card-body d-flex flex-column">
            <div class="ci-icon mb-2"><i class="bi <%= item.icon %> fs-5"></i></div>
            <h6 class="fw-semibold"><%= item.name %></h6>
            <p class="small text-muted flex-grow-1"><%= item.description %></p>
            <a href="/catalog/<%= item.id %>/request" class="btn btn-sm btn-primary w-100">Request</a>
          </div>
        </div>
      </div>
    <% }) %>
    <% if (items.length === 0) { %>
      <div class="col-12 text-muted text-center py-5">No catalog items available.</div>
    <% } %>
  </div>
</div>
<%- include('../partials/foot') %>
