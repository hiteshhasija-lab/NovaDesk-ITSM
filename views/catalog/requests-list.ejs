<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">
      <i class="bi bi-list-check text-primary me-1"></i><%= isEndUser ? 'My Requests' : 'Service Requests' %>
      <% if (filters.status === 'open') { %>
        <span class="badge bg-info text-dark align-middle">Open Only</span>
        <a href="/requests" class="small ms-1">clear</a>
      <% } %>
    </h4>
    <a href="/catalog" class="btn btn-sm btn-outline-secondary"><i class="bi bi-shop"></i> Browse Catalog</a>
  </div>

  <form class="row g-2 mb-3" id="requestsFilterForm" method="GET">
    <div class="col-md-3">
      <input type="text" id="requestsLiveSearch" name="q" value="<%= filters.q || '' %>" class="form-control form-control-sm" placeholder="Search number or item..." autocomplete="off">
    </div>
    <div class="col-md-<%= isEndUser ? 3 : 2 %>">
      <select name="status" class="form-select form-select-sm auto-filter">
        <option value="">All statuses</option>
        <option value="open" <%= filters.status === 'open' ? 'selected' : '' %>>Open (Submitted/In Progress)</option>
        <% ['submitted','in_progress','fulfilled','rejected','cancelled'].forEach(s => { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= h.REQUEST_STATUS_LABELS[s] %></option>
        <% }) %>
      </select>
    </div>
    <% if (!isEndUser) { %>
    <div class="col-md-2">
      <select name="requested_by" class="form-select form-select-sm auto-filter">
        <option value="">Requested by anyone</option>
        <% requesterUsers.forEach(u => { %>
          <option value="<%= u.id %>" <%= String(filters.requested_by) === String(u.id) ? 'selected' : '' %>><%= u.full_name %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <select name="assigned_to" class="form-select form-select-sm auto-filter">
        <option value="">Assigned to anyone</option>
        <option value="unassigned" <%= filters.assigned_to === 'unassigned' ? 'selected' : '' %>>Unassigned</option>
        <% assignableUsers.forEach(u => { %>
          <option value="<%= u.id %>" <%= String(filters.assigned_to) === String(u.id) ? 'selected' : '' %>><%= u.full_name %></option>
        <% }) %>
      </select>
    </div>
    <% } %>
    <div class="col-md-2">
      <button class="btn btn-sm btn-outline-secondary w-100" type="submit">Go</button>
    </div>
  </form>

  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Number</th><th>Item</th><th>Status</th>
            <% if (!isEndUser) { %><th>Requested By</th><% } %>
            <th>Assigned To</th><th>Created</th>
          </tr>
        </thead>
        <tbody id="requestsTableBody">
          <% if (requests.length === 0) { %>
            <tr><td colspan="6" class="text-center text-muted py-4">No requests found.</td></tr>
          <% } %>
          <% requests.forEach(r => { %>
          <tr onclick="window.location='/requests/<%= r.id %>'" data-search="<%= [r.number, r.item_name].filter(Boolean).join(' ').toLowerCase() %>">
            <td class="fw-semibold"><%= r.number %></td>
            <td><i class="bi <%= r.item_icon %> me-1"></i><%= r.item_name %></td>
            <td><span class="badge bg-<%= h.REQUEST_STATUS_BADGE[r.status] %>"><%= h.REQUEST_STATUS_LABELS[r.status] %></span></td>
            <% if (!isEndUser) { %><td><%= r.requester_name || '—' %></td><% } %>
            <td><%= r.assigned_name || '—' %></td>
            <td class="small text-muted"><%= h.fmtDateShort(r.created_at) %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <div id="requestsNoLiveResults" class="text-center text-muted py-4" hidden>No requests match "<span id="requestsNoLiveResultsQuery"></span>".</div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll('#requestsFilterForm .auto-filter').forEach(function (el) {
    el.addEventListener('change', function () { el.form.submit(); });
  });

  (function () {
    var input = document.getElementById('requestsLiveSearch');
    var rows = Array.prototype.slice.call(document.querySelectorAll('#requestsTableBody tr[data-search]'));
    var noResults = document.getElementById('requestsNoLiveResults');
    var noResultsQuery = document.getElementById('requestsNoLiveResultsQuery');
    if (!input || rows.length === 0) return;

    input.addEventListener('input', function () {
      var q = input.value.trim().toLowerCase();
      var visibleCount = 0;
      rows.forEach(function (row) {
        var match = !q || row.getAttribute('data-search').indexOf(q) !== -1;
        row.hidden = !match;
        if (match) visibleCount++;
      });
      noResults.hidden = !(q && visibleCount === 0);
      noResultsQuery.textContent = input.value.trim();
    });
  })();
</script>
<%- include('../partials/foot') %>
