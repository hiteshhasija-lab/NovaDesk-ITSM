<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">
      <i class="bi bi-list-check text-primary me-1"></i><%= isEndUser ? 'My Requests' : 'Service Requests' %>
      <% if (filters.status === 'open') { %>
        <span class="badge bg-info text-dark align-middle">Open Only</span>
        <a href="/requests" class="small ms-1">clear</a>
      <% } %>
    </h4>
    <div class="d-flex gap-2">
      <% if (!isEndUser) { %>
      <a href="/requests/export.csv<%- h.withQuery(query, { page: null }) %>" id="exportCsvBtn" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download"></i> Export CSV</a>
      <% } %>
      <a href="/catalog" class="btn btn-sm btn-outline-secondary"><i class="bi bi-shop"></i> Browse Catalog</a>
    </div>
  </div>

  <form class="row g-2 mb-3" id="requestsFilterForm" method="GET">
    <div class="col-md-3">
      <input type="text" id="requestsLiveSearch" name="q" value="<%= filters.q || '' %>" class="form-control form-control-sm" placeholder="Search number or item..." autocomplete="off">
    </div>
    <div class="col-md-<%= isEndUser ? 3 : 2 %>">
      <select name="status" class="form-select form-select-sm auto-filter">
        <option value="">All statuses</option>
        <option value="open" <%= filters.status === 'open' ? 'selected' : '' %>>Open (Submitted/In Progress)</option>
        <% ['submitted','in_progress','fulfilled','rejected','cancelled'].forEach(s => { %>
          <option value="<%= s %>" <%= filters.status === s ? 'selected' : '' %>><%= h.REQUEST_STATUS_LABELS[s] %></option>
        <% }) %>
      </select>
    </div>
    <% if (!isEndUser) { %>
    <div class="col-md-2">
      <select name="requested_by" class="form-select form-select-sm auto-filter">
        <option value="">Requested by anyone</option>
        <% requesterUsers.forEach(u => { %>
          <option value="<%= u.id %>" <%= String(filters.requested_by) === String(u.id) ? 'selected' : '' %>><%= u.full_name %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <select name="assigned_to" class="form-select form-select-sm auto-filter">
        <option value="">Assigned to anyone</option>
        <option value="unassigned" <%= filters.assigned_to === 'unassigned' ? 'selected' : '' %>>Unassigned</option>
        <% assignableUsers.forEach(u => { %>
          <option value="<%= u.id %>" <%= String(filters.assigned_to) === String(u.id) ? 'selected' : '' %>><%= u.full_name %></option>
        <% }) %>
      </select>
    </div>
    <% } %>
    <div class="col-md-2">
      <button class="btn btn-sm btn-outline-secondary w-100" type="submit">Go</button>
    </div>
  </form>

  <%
    function sortHeader(col, label) {
      const active = sort.key === col;
      const nextDir = active && sort.dir === 'asc' ? 'desc' : 'asc';
      const icon = active ? (sort.dir === 'asc' ? 'bi-caret-up-fill' : 'bi-caret-down-fill') : 'bi-caret-down text-muted opacity-25';
      return `<a href="${h.withQuery(query, { sort: col, dir: nextDir, page: 1 })}" class="text-decoration-none text-reset">${label} <i class="bi ${icon} small"></i></a>`;
    }
  %>
  <div id="requestsResults">
    <div class="card">
      <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle">
          <thead class="table-light">
            <tr>
              <th><%- sortHeader('number', 'Number') %></th><th><%- sortHeader('item_name', 'Item') %></th><th><%- sortHeader('status', 'Status') %></th>
              <% if (!isEndUser) { %><th>Requested By</th><% } %>
              <th>Assigned To</th><th><%- sortHeader('created_at', 'Created') %></th>
            </tr>
          </thead>
          <tbody id="requestsTableBody">
            <% if (requests.length === 0) { %>
              <tr><td colspan="6" class="text-center text-muted py-4">No requests found.</td></tr>
            <% } %>
            <% requests.forEach(r => { %>
            <tr onclick="window.location='/requests/<%= r.id %>'" data-search="<%= [r.number, r.item_name].filter(Boolean).join(' ').toLowerCase() %>">
              <td class="fw-semibold"><%= r.number %></td>
              <td><i class="bi <%= r.item_icon %> me-1"></i><%= r.item_name %></td>
              <td><span class="badge bg-<%= h.REQUEST_STATUS_BADGE[r.status] %>"><%= h.REQUEST_STATUS_LABELS[r.status] %></span></td>
              <% if (!isEndUser) { %><td><%= r.requester_name || '—' %></td><% } %>
              <td><%= r.assigned_name || '—' %></td>
              <td class="small text-muted"><%- h.fmtDateShort(r.created_at) %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>
    <%- include('../partials/pagination', { pagination, query }) %>
  </div>
</div>

<script>
  document.querySelectorAll('#requestsFilterForm .auto-filter').forEach(function (el) {
    el.addEventListener('change', function () { el.form.submit(); });
  });

  (function () {
    var input = document.getElementById('requestsLiveSearch');
    var resultsEl = document.getElementById('requestsResults');
    var exportBtn = document.getElementById('exportCsvBtn');
    if (!input) return;

    if (exportBtn) {
      var baseHref = exportBtn.getAttribute('href').split('?')[0];
      var updateHref = function () {
        var params = new URLSearchParams(window.location.search);
        var q = input.value.trim();
        if (q) { params.set('q', q); } else { params.delete('q'); }
        params.delete('page');
        var qs = params.toString();
        exportBtn.setAttribute('href', baseHref + (qs ? '?' + qs : ''));
      };
      input.addEventListener('input', updateHref);
    }

    // Debounced live search — fetches the real server-side results (the full dataset, not just
    // the rows already on this page) and swaps them in without a full page navigation, so the
    // search box never loses focus or cursor position while typing. A generation counter
    // discards any response that's no longer the latest one requested.
    if (resultsEl) {
      var searchTimer = null;
      var generation = 0;
      input.addEventListener('input', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(function () {
          var params = new URLSearchParams(window.location.search);
          var q = input.value.trim();
          if (q) { params.set('q', q); } else { params.delete('q'); }
          params.delete('page');
          var qs = params.toString();
          var url = window.location.pathname + (qs ? '?' + qs : '');
          var myGen = ++generation;
          fetch(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(function (res) { return res.text(); })
            .then(function (html) {
              if (myGen !== generation) return;
              var fresh = new DOMParser().parseFromString(html, 'text/html').getElementById('requestsResults');
              if (fresh) resultsEl.innerHTML = fresh.innerHTML;
              history.replaceState(null, '', url);
            })
            .catch(function () {});
        }, 350);
      });
    }
  })();
</script>
<%- include('../partials/foot') %>
