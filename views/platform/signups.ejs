<%- include('_head') %>
<div class="container-fluid px-4 py-4" style="max-width: 1200px;">
  <h4 class="mb-1">Sign-ups</h4>
  <% if (!signupHost) { %>
  <p class="text-muted small">Self-service sign-up is not switched on: it needs <code>SIGNUP_HOST</code> (with <code>TENANT_BASE_DOMAIN</code> and <code>SMTP_HOST</code>) in the application's environment.</p>
  <% } else { %>
  <p class="text-muted small">The sign-up page is at <code><%= cfg.scheme %>://<%= signupHost %></code>. A workspace is made only after the person has confirmed their email address. <%= cfg.approval ? 'Each new workspace starts switched off, for you to look at and switch on (Tenants).' : 'Each new workspace starts switched on.' %> They start with limits of <%= ['people ' + (cfg.limits.users === null ? 'none' : cfg.limits.users), 'records ' + (cfg.limits.records === null ? 'none' : cfg.limits.records), 'files ' + (cfg.limits.storageMb === null ? 'none' : cfg.limits.storageMb + ' MB')].join(', ') %> (you change them per tenant). At most <%= cfg.maxPerDay || 'any number of' %> requests a day and <%= cfg.perIpPerHour %> an hour from one address.</p>
  <div class="card mb-3"><div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
    <div><strong><%= day %></strong> request<%= day === 1 ? '' : 's' %> in the last 24 hours. Sign-ups are <strong class="<%= paused ? 'text-danger' : 'text-success' %>"><%= paused ? 'paused' : 'open' %></strong>.</div>
    <form method="POST" action="/signups/pause" class="m-0">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="paused" value="<%= paused ? 'false' : 'true' %>">
      <button class="btn btn-sm <%= paused ? 'btn-success' : 'btn-outline-danger' %>" type="submit"><%= paused ? 'Open sign-ups again' : 'Pause sign-ups' %></button>
    </form>
  </div></div>
  <% } %>
  <div class="card"><div class="table-responsive"><table class="table table-sm align-middle mb-0">
    <thead class="table-light"><tr><th>Asked</th><th>Organisation</th><th>Short name</th><th>Email</th><th>Status</th><th>Tenant</th><th>Address</th></tr></thead>
    <tbody>
    <% if (!rows.length) { %><tr><td colspan="7" class="text-muted small">Nobody has asked yet.</td></tr><% } %>
    <% rows.forEach(function (r) { %>
      <tr>
        <td class="small"><%= r.created_at %></td><td><%= r.org_name %></td><td><code><%= r.slug %></code></td><td class="small"><%= r.admin_email %></td>
        <td><span class="badge bg-<%= r.status === 'completed' ? 'success' : (r.status === 'pending' ? 'info text-dark' : (r.status === 'creating' ? 'primary' : (r.status === 'refused' ? 'danger' : 'secondary'))) %>"><%= r.status %></span><% if (r.note) { %> <span class="small text-muted"><%= r.note %></span><% } %></td>
        <td><% if (r.tenant_id) { %><a href="/tenants/<%= r.tenant_id %>">open</a><% } else { %>—<% } %></td>
        <td class="small text-muted"><%= r.ip || '' %></td>
      </tr>
    <% }) %>
    </tbody>
  </table></div></div>
</div>
<%- include('../partials/foot') %>
