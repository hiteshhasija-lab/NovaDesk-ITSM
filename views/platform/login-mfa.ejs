<%- include('../partials/head') %>
<div class="container py-5" style="max-width: 420px;">
  <h4 class="mb-1"><i class="bi bi-shield-lock text-primary me-2"></i>Two-step verification</h4>
  <p class="text-muted small">Enter the 6-digit code from your authenticator app, or one of your recovery codes.</p>
  <% if (error) { %><div class="alert alert-danger py-2 small"><%= error %></div><% } %>
  <form method="POST" action="/login/mfa" class="card card-body" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label class="form-label" for="code">Code</label>
    <input class="form-control mb-3" id="code" name="code" inputmode="numeric" autocomplete="one-time-code" maxlength="20" required autofocus>
    <button class="btn btn-primary" type="submit">Verify</button>
  </form>
  <p class="small mt-3"><a href="/login">Start again</a></p>
</div>
<%- include('../partials/foot') %>
