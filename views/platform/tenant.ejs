<%- include('_head') %>
<div class="container-fluid px-4 py-4" style="max-width: 1000px;">
  <p class="small"><a href="/">&larr; Tenants</a></p>
  <h4 class="mb-1"><%= tenant.name %> <span class="badge bg-<%= tenant.status === 'active' ? 'success' : (tenant.status === 'pending_deletion' ? 'danger' : 'warning text-dark') %>"><%= tenant.status === 'pending_deletion' ? 'waiting to be deleted' : tenant.status %></span></h4>
  <p class="text-muted small"><code><%= tenant.slug %></code> · made <%= tenant.created_at %> · <%= tenant.active_users %> of <%= tenant.users %> people active · <%= tenant.incidents %> incidents · <%= tenant.requests %> requests · <%= tenant.changes %> changes</p>
  <% if (error) { %><div class="alert alert-danger py-2 small"><%= error %></div><% } %>
  <% if (typeof flash !== 'undefined' && flash) { %><div class="alert alert-success py-2 small"><%= flash %></div><% } %>

  <div class="card mb-3"><div class="card-body"><h6 class="section-title">Name</h6>
    <form method="POST" action="/tenants/<%= tenant.id %>/rename" class="d-flex gap-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><input class="form-control" name="name" maxlength="80" value="<%= tenant.name %>" required><button class="btn btn-outline-primary" type="submit">Rename</button></form>
  </div></div>

  <div class="card mb-3"><div class="card-body"><h6 class="section-title">Host names</h6>
    <% if (!tenant.hosts.length) { %><p class="small text-muted">None. Only <code><%= tenant.slug %></code> under the base domain, if one is set, reaches this tenant.</p><% } %>
    <% tenant.hosts.forEach(function (h) { %>
      <form method="POST" action="/tenants/<%= tenant.id %>/hosts/remove" class="d-flex align-items-center gap-2 mb-1"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="host" value="<%= h %>"><code><%= h %></code><button class="btn btn-sm btn-outline-danger" type="submit">Remove</button></form>
    <% }) %>
    <form method="POST" action="/tenants/<%= tenant.id %>/hosts" class="d-flex gap-2 mt-2"><input type="hidden" name="_csrf" value="<%= csrf %>"><input class="form-control" name="host" placeholder="help.acme.example" required><button class="btn btn-outline-primary" type="submit">Add</button></form>
  </div></div>

  <div class="card mb-3"><div class="card-body"><h6 class="section-title">Status</h6>
    <% if (isDefault) { %><p class="small text-muted mb-0">The default tenant cannot be suspended.</p><% } else if (tenant.status === 'pending_deletion') { %><p class="small text-muted mb-0">Its status cannot change while deletion is scheduled (below).</p><% } else { %>
    <p class="small text-muted">A suspended tenant's pages answer 503 and its API keys and SCIM tokens are refused. Its data is kept.</p>
    <form method="POST" action="/tenants/<%= tenant.id %>/status"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="status" value="<%= tenant.status === 'active' ? 'suspended' : 'active' %>">
      <button class="btn btn-<%= tenant.status === 'active' ? 'outline-warning' : 'outline-success' %>" type="submit"><%= tenant.status === 'active' ? 'Suspend this tenant' : 'Reactivate this tenant' %></button></form>
    <% } %>
  </div></div>

  <div class="card mb-3"><div class="card-body"><h6 class="section-title">Limits and usage</h6>
    <p class="small text-muted">What this tenant may hold. Empty means no limit. A limit is enforced by the database for every way of adding something (pages, API, SCIM, single sign-on, inbound mail, imports). Lowering one below what is used deletes nothing: it only stops new things.</p>
    <form method="POST" action="/tenants/<%= tenant.id %>/limits" class="row g-3">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="col-md-4"><label class="form-label" for="limit_users">Active people</label><input class="form-control" id="limit_users" name="limit_users" inputmode="numeric" value="<%= tenant.limit_users === null ? '' : tenant.limit_users %>" placeholder="no limit"><div class="form-text">used: <%= usage.users.used %></div></div>
      <div class="col-md-4"><label class="form-label" for="limit_records">Records</label><input class="form-control" id="limit_records" name="limit_records" inputmode="numeric" value="<%= tenant.limit_records === null ? '' : tenant.limit_records %>" placeholder="no limit"><div class="form-text">used: <%= usage.records.used %> (incidents, requests, changes, problems, CIs, articles)</div></div>
      <div class="col-md-4"><label class="form-label" for="limit_storage_mb">Attached files (MB)</label><input class="form-control" id="limit_storage_mb" name="limit_storage_mb" inputmode="numeric" value="<%= tenant.limit_storage_mb === null ? '' : tenant.limit_storage_mb %>" placeholder="no limit"><div class="form-text">used: <%= usage.storage.usedMb %> MB</div></div>
      <div class="col-12"><button class="btn btn-outline-primary" type="submit">Save the limits</button></div>
    </form>
  </div></div>

  <div class="card mb-3"><div class="card-body"><h6 class="section-title">Administrators</h6>
    <table class="table table-sm"><thead class="table-light"><tr><th>Username</th><th>Name</th><th>Email</th><th>Active</th></tr></thead><tbody>
    <% admins.forEach(function (a) { %><tr><td><code><%= a.username %></code></td><td><%= a.full_name %></td><td><%= a.email || '—' %></td><td><%= a.active ? 'yes' : 'no' %></td></tr><% }) %>
    </tbody></table>
    <p class="small text-muted">Locked out? Set a new password for one of them. It ends their open sessions and is written in the tenant's own audit log as done by the platform.</p>
    <form method="POST" action="/tenants/<%= tenant.id %>/reset-admin" class="row g-2" autocomplete="off"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="col-md-4"><input class="form-control" name="username" placeholder="administrator's username" required></div>
      <div class="col-md-5"><input class="form-control" type="password" name="password" placeholder="new password" autocomplete="new-password" required></div>
      <div class="col-md-3"><button class="btn btn-outline-danger w-100" type="submit">Set the password</button></div>
    </form>
  </div></div>

  <% if (!isDefault) { %>
  <div class="card mb-3 border-secondary"><div class="card-body">
    <h6 class="section-title">Export everything this tenant owns</h6>
    <p class="small text-muted">One download (tar.gz): a file of rows for every table, the files attached to records, the logo and the sign-in picture, and a manifest. <strong>Credentials and secrets are never in it</strong> (password hashes, API key and token hashes, two-step secrets, stored provider and mail passwords), nor are sessions. The export is recorded here with its checksum.</p>
    <% if (tenant.export_at) { %><p class="small mb-2">Last export: <%= tenant.export_at %> UTC by <%= tenant.export_by %>, <%= Math.round(tenant.export_bytes / 1024) %> KB, <code class="user-select-all"><%= (tenant.export_sha256 || '').slice(0, 16) %>…</code><% if (tenant.status_changed_at && tenant.export_at > tenant.status_changed_at && tenant.status !== 'active') { %> <span class="badge bg-success">final: made after it was suspended</span><% } else if (tenant.status === 'active') { %> <span class="badge bg-warning text-dark">tenant is still active: not final</span><% } else { %> <span class="badge bg-warning text-dark">older than the suspension: not final</span><% } %></p><% } %>
    <form method="POST" action="/tenants/<%= tenant.id %>/export" class="row g-2" autocomplete="off"><input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="col-md-8"><input class="form-control" type="password" name="confirm" placeholder="Enter <%= reauthWords %>" autocomplete="off" required></div>
      <div class="col-md-4"><button class="btn btn-outline-secondary w-100" type="submit">Download the export</button></div>
    </form>
  </div></div>

  <div class="card mb-3 border-danger"><div class="card-body">
    <h6 class="section-title text-danger">Delete this tenant</h6>
    <% if (tenant.status === 'pending_deletion') { %>
      <p class="mb-2"><span class="badge bg-danger">scheduled</span> Everything this tenant owns will be deleted on or after <strong><%= tenant.deletion_scheduled_at %> UTC</strong> (asked for by <%= tenant.deletion_requested_by %>). Its pages are closed meanwhile.</p>
      <form method="POST" action="/tenants/<%= tenant.id %>/delete/cancel"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn btn-outline-success" type="submit">Call the deletion off</button></form>
    <% } else if (deleteBlocker) { %>
      <p class="small text-muted mb-0">Not yet possible. <%= deleteBlocker %></p>
    <% } else { %>
      <p class="small">This removes <strong>everything</strong> the tenant owns (people, records, files, settings, logs) and its host names, <%= graceDays %> day<%= graceDays === 1 ? '' : 's' %> from now, and cannot be undone after that. Until then you can call it off. The deletion rests on the final export above.</p>
      <form method="POST" action="/tenants/<%= tenant.id %>/delete" class="row g-2" autocomplete="off"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="col-md-4"><input class="form-control" name="slug" placeholder="type <%= tenant.slug %> to confirm" autocomplete="off" required></div>
        <div class="col-md-5"><input class="form-control" type="password" name="confirm" placeholder="Enter <%= reauthWords %>" autocomplete="off" required></div>
        <div class="col-md-3"><button class="btn btn-danger w-100" type="submit">Schedule deletion</button></div>
      </form>
    <% } %>
  </div></div>
  <% } %>

  <div class="card"><div class="card-body"><h6 class="section-title">What the platform did here</h6>
    <% if (!history.length) { %><p class="small text-muted mb-0">Nothing yet.</p><% } else { %>
    <table class="table table-sm small"><tbody><% history.forEach(function (e) { %><tr><td class="text-nowrap"><%= e.created_at %></td><td><%= e.operator || '—' %></td><td><code><%= e.action %></code></td><td><%= e.detail || '' %></td></tr><% }) %></tbody></table><% } %>
  </div></div>
</div>
<%- include('../partials/foot') %>
