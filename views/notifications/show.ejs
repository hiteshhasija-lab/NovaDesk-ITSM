<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4" style="max-width: 900px;">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-envelope-open text-primary me-1"></i>Notification</h4>
    <a href="/notifications" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Notifications</a>
  </div>
  <div class="card">
    <div class="card-body">
      <dl class="row mb-3 small">
        <dt class="col-sm-2 text-muted">Subject</dt><dd class="col-sm-10"><%= notification.subject %></dd>
        <dt class="col-sm-2 text-muted">To</dt><dd class="col-sm-10"><%= notification.recipient_name || '' %> &lt;<%= notification.recipient_email %>&gt;</dd>
        <dt class="col-sm-2 text-muted">Sent</dt><dd class="col-sm-10"><%- h.fmtDate(notification.created_at) %></dd>
        <dt class="col-sm-2 text-muted">Status</dt><dd class="col-sm-10"><%- include('../partials/mail-status', { n: notification }) %><% if (notification.error) { %> <span class="text-muted"><%= notification.error %></span><% } %></dd>
        <% if (notification.related_type === 'change' && notification.related_id) { %>
        <dt class="col-sm-2 text-muted">Related</dt><dd class="col-sm-10"><a href="/changes/<%= notification.related_id %>">Change #<%= notification.related_id %></a></dd>
        <% } else if (notification.related_type === 'incident' && notification.related_id) { %>
        <dt class="col-sm-2 text-muted">Related</dt><dd class="col-sm-10"><a href="/incidents/<%= notification.related_id %>">Incident #<%= notification.related_id %></a></dd>
        <% } %>
      </dl>
      <% if (notification.body) { %>
        <!-- The email's HTML in a sandboxed frame: no scripts, forms or same-origin access. -->
        <iframe sandbox referrerpolicy="no-referrer" title="Email body" srcdoc="<%= notification.body %>"
                style="width:100%; min-height:320px; border:1px solid #dee2e6; border-radius:.375rem; background:#fff;"></iframe>
      <% } else { %>
        <p class="text-muted mb-0">The body of this email was not stored.</p>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
