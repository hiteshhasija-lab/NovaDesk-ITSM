<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-envelope text-primary me-1"></i>Notifications</h4>
  </div>
  <p class="text-muted small">Every email NovaDesk has tried to send. Since this is a demo environment, messages go to a sandbox inbox — use "Preview" to see exactly what was sent.</p>

  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr>
            <th>Sent</th><th>To</th><th>Subject</th><th>Related</th><th>Status</th><th></th>
          </tr>
        </thead>
        <tbody>
          <% if (notifications.length === 0) { %>
            <tr><td colspan="6" class="text-center text-muted py-4">No notifications yet.</td></tr>
          <% } %>
          <% notifications.forEach(n => { %>
          <tr>
            <td class="small text-muted"><%= h.fmtDate(n.created_at) %></td>
            <td><%= n.recipient_name || n.recipient_email %><div class="small text-muted"><%= n.recipient_email %></div></td>
            <td><%= n.subject %></td>
            <td>
              <% if (n.related_type === 'incident') { %>
                <a href="/incidents/<%= n.related_id %>">Incident #<%= n.related_id %></a>
              <% } else if (n.related_type === 'change') { %>
                <a href="/changes/<%= n.related_id %>">Change #<%= n.related_id %></a>
              <% } else { %>—<% } %>
            </td>
            <td><span class="badge bg-<%= n.status === 'sent' ? 'success' : 'secondary' %> text-capitalize"><%= n.status %></span></td>
            <td>
              <% if (n.preview_url) { %>
                <a href="<%= n.preview_url %>" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary">Preview</a>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
