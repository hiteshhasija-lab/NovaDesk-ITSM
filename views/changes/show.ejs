<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<%
  function toLocalInput(d) {
    if (!d) return '';
    return d.replace(' ', 'T').slice(0, 16);
  }
%>
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h4 class="mb-0"><%= change.number %>
        <span class="badge bg-<%= change.risk === 'high' ? 'danger' : change.risk === 'medium' ? 'warning' : 'secondary' %> text-capitalize ms-2"><%= change.risk %> risk</span>
        <span class="badge bg-<%= h.CHANGE_STATUS_BADGE[change.status] %>"><%= h.CHANGE_STATUS_LABELS[change.status] %></span>
      </h4>
      <div class="text-muted"><%= change.short_description %></div>
    </div>
    <a href="/changes" class="btn btn-sm btn-outline-secondary">&larr; Back to list</a>
  </div>

  <% if (change.approval_status === 'pending' && !['cancelled','rejected','closed'].includes(change.status) && (currentUser.role === 'admin' || currentUser.role === 'agent')) { %>
  <div class="alert alert-info d-flex justify-content-between align-items-center">
    <span><i class="bi bi-hourglass-split me-1"></i> This change is awaiting approval.</span>
    <div>
      <form method="POST" action="/changes/<%= change.id %>/approve" class="d-inline">
        <input type="hidden" name="decision" value="approve">
        <button class="btn btn-sm btn-success"><i class="bi bi-check-lg"></i> Approve</button>
      </form>
      <form method="POST" action="/changes/<%= change.id %>/approve" class="d-inline">
        <input type="hidden" name="decision" value="reject">
        <button class="btn btn-sm btn-danger"><i class="bi bi-x-lg"></i> Reject</button>
      </form>
    </div>
  </div>
  <% } %>

  <div class="row g-3">
    <div class="col-lg-8">
      <div class="card mb-3">
        <div class="card-body">
          <h6 class="section-title">Details</h6>
          <% if (currentUser.role === 'user') { %>
            <dl class="row mb-0">
              <dt class="col-sm-3">Description</dt><dd class="col-sm-9"><%= change.description || '—' %></dd>
              <dt class="col-sm-3">Change Type</dt><dd class="col-sm-9 text-capitalize"><%= change.change_type %></dd>
              <dt class="col-sm-3">Risk</dt><dd class="col-sm-9 text-capitalize"><%= change.risk %></dd>
              <dt class="col-sm-3">Assigned To</dt><dd class="col-sm-9"><%= change.assigned_name || 'Unassigned' %></dd>
              <dt class="col-sm-3">Planned Start</dt><dd class="col-sm-9"><%= change.planned_start ? h.fmtDate(change.planned_start) : '—' %></dd>
              <dt class="col-sm-3">Planned End</dt><dd class="col-sm-9"><%= change.planned_end ? h.fmtDate(change.planned_end) : '—' %></dd>
              <dt class="col-sm-3">Affected CI</dt><dd class="col-sm-9"><%= change.ci_name ? change.ci_number + ' — ' + change.ci_name : '—' %></dd>
              <dt class="col-sm-3">Implementation Plan</dt><dd class="col-sm-9"><%= change.implementation_plan || '—' %></dd>
              <dt class="col-sm-3">Backout Plan</dt><dd class="col-sm-9"><%= change.backout_plan || '—' %></dd>
            </dl>
            <% if (change.requested_by === currentUser.id && ['draft','submitted'].includes(change.status)) { %>
            <hr>
            <form method="POST" action="/changes/<%= change.id %>/cancel" onsubmit="return confirm('Cancel change request <%= change.number %>?');">
              <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-circle"></i> Cancel Request</button>
            </form>
            <% } %>
          <% } else { %>
          <form method="POST" action="/changes/<%= change.id %>/update">
            <div class="row g-3">
              <div class="col-md-12">
                <label class="form-label">Short Description</label>
                <input type="text" name="short_description" class="form-control" value="<%= change.short_description %>" required>
              </div>
              <div class="col-md-12">
                <label class="form-label">Description</label>
                <textarea name="description" class="form-control" rows="3"><%= change.description || '' %></textarea>
              </div>
              <div class="col-md-3">
                <label class="form-label">Change Type</label>
                <select name="change_type" class="form-select">
                  <% ['standard','normal','emergency'].forEach(t => { %>
                    <option value="<%= t %>" <%= change.change_type === t ? 'selected' : '' %>><%= t[0].toUpperCase()+t.slice(1) %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label">Risk</label>
                <select name="risk" class="form-select">
                  <% ['low','medium','high'].forEach(r => { %>
                    <option value="<%= r %>" <%= change.risk === r ? 'selected' : '' %>><%= r[0].toUpperCase()+r.slice(1) %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                  <% ['draft','submitted','approved','rejected','scheduled','implemented','closed','cancelled'].forEach(s => { %>
                    <option value="<%= s %>" <%= change.status === s ? 'selected' : '' %>><%= h.CHANGE_STATUS_LABELS[s] %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-3">
                <label class="form-label">Assigned To</label>
                <select name="assigned_to" class="form-select">
                  <option value="">Unassigned</option>
                  <% users.filter(u => u.role !== 'user').forEach(u => { %>
                    <option value="<%= u.id %>" <%= change.assigned_to === u.id ? 'selected' : '' %>><%= u.full_name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Planned Start</label>
                <input type="datetime-local" name="planned_start" class="form-control" value="<%= toLocalInput(change.planned_start) %>">
              </div>
              <div class="col-md-6">
                <label class="form-label">Planned End</label>
                <input type="datetime-local" name="planned_end" class="form-control" value="<%= toLocalInput(change.planned_end) %>">
              </div>
              <div class="col-md-6">
                <label class="form-label">Affected Configuration Item</label>
                <select name="affected_ci_id" class="form-select">
                  <option value="">None</option>
                  <% cis.forEach(c => { %>
                    <option value="<%= c.id %>" <%= change.affected_ci_id === c.id ? 'selected' : '' %>><%= c.ci_number %> — <%= c.name %></option>
                  <% }) %>
                </select>
              </div>
              <div class="col-md-6">
                <label class="form-label">Implementation Plan</label>
                <textarea name="implementation_plan" class="form-control" rows="3"><%= change.implementation_plan || '' %></textarea>
              </div>
              <div class="col-md-6">
                <label class="form-label">Backout Plan</label>
                <textarea name="backout_plan" class="form-control" rows="3"><%= change.backout_plan || '' %></textarea>
              </div>
            </div>
            <div class="mt-3">
              <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Changes</button>
            </div>
          </form>
          <% } %>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
          <span><i class="bi bi-paperclip"></i> Attachments</span>
          <span class="badge bg-secondary"><%= attachments.length %></span>
        </div>
        <div class="list-group list-group-flush">
          <% if (attachments.length === 0) { %>
            <div class="list-group-item text-muted small">No files attached.</div>
          <% } %>
          <% attachments.forEach(a => { %>
            <div class="list-group-item d-flex justify-content-between align-items-center">
              <a href="/changes/<%= change.id %>/attachments/<%= a.id %>/download" class="text-decoration-none">
                <i class="bi bi-file-earmark-arrow-down me-1"></i><%= a.original_name %>
              </a>
              <div class="d-flex align-items-center gap-2">
                <span class="small text-muted"><%= Math.ceil(a.size / 1024) %> KB · <%= a.uploader_name || 'Unknown' %></span>
                <% if (currentUser.role !== 'user' || a.uploaded_by === currentUser.id) { %>
                <form method="POST" action="/changes/<%= change.id %>/attachments/<%= a.id %>/delete" onsubmit="return confirm('Remove this attachment?');">
                  <button type="submit" class="btn btn-sm btn-link text-danger p-0"><i class="bi bi-trash"></i></button>
                </form>
                <% } %>
              </div>
            </div>
          <% }) %>
        </div>
        <div class="card-body">
          <form method="POST" action="/changes/<%= change.id %>/attachments" enctype="multipart/form-data" class="d-flex gap-2">
            <input type="file" name="file" class="form-control form-control-sm" required>
            <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-upload"></i> Upload</button>
          </form>
        </div>
      </div>

      <div class="card">
        <div class="card-header fw-semibold">Activity &amp; Comments</div>
        <div class="list-group list-group-flush">
          <% if (timeline.length === 0) { %>
            <div class="list-group-item text-muted">Nothing here yet.</div>
          <% } %>
          <% timeline.forEach(item => { %>
            <% if (item.type === 'activity') { %>
              <div class="list-group-item small text-muted d-flex align-items-center gap-2">
                <i class="bi bi-clock-history"></i>
                <span><strong><%= item.author_name || 'System' %></strong> — <%= item.text %></span>
                <span class="ms-auto"><%= h.fmtDate(item.created_at) %></span>
              </div>
            <% } else { %>
              <div class="list-group-item">
                <div class="d-flex justify-content-between">
                  <strong><%= item.author_name || 'Unknown' %></strong>
                  <span class="small text-muted"><%= h.fmtDate(item.created_at) %></span>
                </div>
                <div><%= item.text %></div>
              </div>
            <% } %>
          <% }) %>
        </div>
        <div class="card-body">
          <form method="POST" action="/changes/<%= change.id %>/comments">
            <textarea name="comment" class="form-control mb-2" rows="2" placeholder="Add a comment..." required></textarea>
            <button type="submit" class="btn btn-sm btn-primary">Post</button>
          </form>
        </div>
      </div>
    </div>

    <div class="col-lg-4">
      <div class="card mb-3">
        <div class="card-body d-flex justify-content-between align-items-center">
          <div><i class="bi bi-eye me-1"></i><strong><%= watchers.length %></strong> watching</div>
          <form method="POST" action="/changes/<%= change.id %>/<%= watching ? 'unwatch' : 'watch' %>">
            <button type="submit" class="btn btn-sm <%= watching ? 'btn-secondary' : 'btn-outline-primary' %>">
              <i class="bi bi-<%= watching ? 'eye-slash' : 'eye' %>"></i> <%= watching ? 'Unwatch' : 'Watch' %>
            </button>
          </form>
        </div>
        <% if (watchers.length > 0) { %>
        <div class="card-footer small text-muted"><%= watchers.map(w => w.full_name).join(', ') %></div>
        <% } %>
      </div>

      <div class="card">
        <div class="card-body">
          <h6 class="section-title">Summary</h6>
          <dl class="row mb-0 small">
            <dt class="col-sm-6">Requested By</dt><dd class="col-sm-6"><%= change.requester_name || '—' %></dd>
            <dt class="col-sm-6">Assigned To</dt><dd class="col-sm-6"><%= change.assigned_name || 'Unassigned' %></dd>
            <dt class="col-sm-6">Approval Status</dt><dd class="col-sm-6 text-capitalize"><%= change.approval_status %></dd>
            <dt class="col-sm-6">Approved By</dt><dd class="col-sm-6"><%= change.approver_name || '—' %></dd>
            <dt class="col-sm-6">Created</dt><dd class="col-sm-6"><%= h.fmtDate(change.created_at) %></dd>
            <dt class="col-sm-6">Closed</dt><dd class="col-sm-6"><%= change.closed_at ? h.fmtDate(change.closed_at) : '—' %></dd>
          </dl>
          <% if (change.affected_ci_id) { %>
          <hr>
          <a href="/cmdb/<%= change.affected_ci_id %>" class="btn btn-sm btn-outline-primary w-100">
            <i class="bi bi-hdd-stack"></i> View Affected CI: <%= change.ci_name %>
          </a>
          <% } %>
        </div>
      </div>

      <% if (currentUser.role === 'admin') { %>
      <div class="card mt-3 border-danger">
        <div class="card-body">
          <h6 class="text-danger">Danger Zone</h6>
          <p class="small text-muted">Deleting removes this change request and its comments permanently. Consider setting status to Rejected instead if you need to preserve the record.</p>
          <form method="POST" action="/changes/<%= change.id %>/delete" onsubmit="return confirm('Delete change <%= change.number %>? This cannot be undone.');">
            <button type="submit" class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-trash"></i> Delete Change</button>
          </form>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
