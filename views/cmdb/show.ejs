<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h4 class="mb-0"><%= ci.ci_number %> — <%= ci.name %>
        <span class="badge bg-<%= h.CI_STATUS_BADGE[ci.status] %> ms-2"><%= h.CI_STATUS_LABELS[ci.status] %></span>
      </h4>
      <div class="text-muted"><%= h.CI_TYPE_LABELS[ci.ci_type] || ci.ci_type %> · <span><%= h.ENVIRONMENT_LABELS[ci.environment] || ci.environment %></span></div>
    </div>
    <div>
      <% if (currentUser.role !== 'user') { %>
      <a href="/cmdb/<%= ci.id %>/edit" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
      <% } %>
      <a href="/cmdb" class="btn btn-sm btn-outline-secondary">&larr; Back to list</a>
    </div>
  </div>

  <% if (upstream.length > 0 || downstream.length > 0) { %>
  <%
    const rowH = 54;
    const boxH = 38;
    const maxRows = Math.max(upstream.length, downstream.length, 1);
    const svgHeight = maxRows * rowH + 30;
    const centerY = svgHeight / 2;
    function boxY(i, count) {
      const totalH = count * rowH;
      const startY = centerY - totalH / 2;
      return startY + i * rowH + (rowH - boxH) / 2;
    }
    const centerX = 350, centerW = 200, centerBoxH = 50;
    const sideW = 210, leftX = 20, rightX = 690;
  %>
  <div class="card mb-3" style="max-width: 75%;">
    <div class="card-header fw-semibold"><i class="bi bi-diagram-3 me-1"></i>Dependency Map</div>
    <div class="card-body" style="overflow-x:auto;">
      <svg viewBox="0 0 920 <%= svgHeight %>" style="min-width:615px;width:100%;height:auto;" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <marker id="arrowHead" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto">
            <path d="M0,0 L8,4 L0,8 z" style="fill:var(--brand)"></path>
          </marker>
        </defs>

        <% upstream.forEach((u, i) => { %>
          <% const y = boxY(i, upstream.length); %>
          <line x1="<%= leftX + sideW %>" y1="<%= y + boxH/2 %>" x2="<%= centerX %>" y2="<%= centerY %>"
                style="stroke:var(--border);stroke-width:1.5" marker-end="url(#arrowHead)"></line>
          <rect x="<%= leftX %>" y="<%= y %>" width="<%= sideW %>" height="<%= boxH %>" rx="6"
                style="fill:var(--surface);stroke:var(--border)"></rect>
          <text x="<%= leftX + 10 %>" y="<%= y + 16 %>" style="fill:var(--text);font-size:11px;font-weight:600;font-family:sans-serif"><%= u.number %></text>
          <text x="<%= leftX + 10 %>" y="<%= y + 30 %>" style="fill:var(--text-muted);font-size:10.5px;font-family:sans-serif"><%= (u.name || '').slice(0, 26) %></text>
        <% }) %>

        <rect x="<%= centerX %>" y="<%= centerY - centerBoxH/2 %>" width="<%= centerW %>" height="<%= centerBoxH %>" rx="8"
              style="fill:var(--brand);stroke:var(--brand-dark)"></rect>
        <text x="<%= centerX + centerW/2 %>" y="<%= centerY - 3 %>" text-anchor="middle" style="fill:#fff;font-size:12px;font-weight:700;font-family:sans-serif"><%= ci.ci_number %></text>
        <text x="<%= centerX + centerW/2 %>" y="<%= centerY + 15 %>" text-anchor="middle" style="fill:#fff;font-size:11px;font-family:sans-serif"><%= ci.name.slice(0, 24) %></text>

        <% downstream.forEach((d, i) => { %>
          <% const y = boxY(i, downstream.length); %>
          <line x1="<%= centerX + centerW %>" y1="<%= centerY %>" x2="<%= rightX %>" y2="<%= y + boxH/2 %>"
                style="stroke:var(--border);stroke-width:1.5" marker-end="url(#arrowHead)"></line>
          <rect x="<%= rightX %>" y="<%= y %>" width="<%= sideW %>" height="<%= boxH %>" rx="6"
                style="fill:var(--surface);stroke:var(--border)"></rect>
          <text x="<%= rightX + 10 %>" y="<%= y + 16 %>" style="fill:var(--text);font-size:11px;font-weight:600;font-family:sans-serif"><%= d.number %></text>
          <text x="<%= rightX + 10 %>" y="<%= y + 30 %>" style="fill:var(--text-muted);font-size:10.5px;font-family:sans-serif"><%= (d.name || '').slice(0, 26) %></text>
        <% }) %>
      </svg>
      <div class="d-flex justify-content-between small text-muted mt-1">
        <span><% if (upstream.length) { %>&larr; Depends on<% } %></span>
        <span><% if (downstream.length) { %>Used by &rarr;<% } %></span>
      </div>
    </div>
  </div>
  <% } %>

  <div class="row g-3">
    <div class="col-lg-7">
      <div class="card mb-3">
        <div class="card-body">
          <h6 class="section-title">Asset Details</h6>
          <dl class="row mb-0 small">
            <dt class="col-sm-4">IP Address</dt><dd class="col-sm-8"><%= ci.ip_address || '—' %></dd>
            <dt class="col-sm-4">Operating System</dt><dd class="col-sm-8"><%= ci.os || '—' %></dd>
            <dt class="col-sm-4">Manufacturer / Model</dt><dd class="col-sm-8"><%= [ci.manufacturer, ci.model].filter(Boolean).join(' / ') || '—' %></dd>
            <dt class="col-sm-4">Serial Number</dt><dd class="col-sm-8"><%= ci.serial_number || '—' %></dd>
            <dt class="col-sm-4">Location</dt><dd class="col-sm-8"><%= ci.location || '—' %></dd>
            <dt class="col-sm-4">Owner</dt><dd class="col-sm-8"><%= ci.owner_name || '—' %></dd>
            <dt class="col-sm-4">Support Group</dt><dd class="col-sm-8"><%= ci.support_group || '—' %></dd>
            <dt class="col-sm-4">CPU</dt><dd class="col-sm-8"><%= ci.cpu || '—' %></dd>
            <dt class="col-sm-4">RAM</dt><dd class="col-sm-8"><%= ci.ram || '—' %></dd>
            <dt class="col-sm-4">Disk</dt><dd class="col-sm-8"><%= ci.disk || '—' %></dd>
            <dt class="col-sm-4">Purchase Date</dt><dd class="col-sm-8"><%= ci.purchase_date || '—' %></dd>
            <dt class="col-sm-4">Warranty Expiry</dt><dd class="col-sm-8"><%= ci.warranty_expiry || '—' %></dd>
            <dt class="col-sm-4">Install Date</dt><dd class="col-sm-8"><%= ci.install_date || '—' %></dd>
            <dt class="col-sm-4">Notes</dt><dd class="col-sm-8"><%= ci.notes || '—' %></dd>
          </dl>
        </div>
      </div>

      <div class="card mb-3">
        <div class="card-header fw-semibold">Related Incidents</div>
        <div class="list-group list-group-flush">
          <% if (relatedIncidents.length === 0) { %>
            <div class="list-group-item text-muted">No related incidents.</div>
          <% } %>
          <% relatedIncidents.forEach(inc => { %>
            <a href="/incidents/<%= inc.id %>" class="list-group-item list-group-item-action d-flex justify-content-between">
              <span><span class="badge bg-<%= h.PRIORITY_BADGE[inc.priority] %> me-2">P<%= inc.priority %></span><%= inc.number %> — <%= inc.short_description %></span>
              <span class="badge bg-<%= h.INCIDENT_STATUS_BADGE[inc.status] %>"><%= h.INCIDENT_STATUS_LABELS[inc.status] %></span>
            </a>
          <% }) %>
        </div>
      </div>

      <div class="card">
        <div class="card-header fw-semibold">Related Change Requests</div>
        <div class="list-group list-group-flush">
          <% if (relatedChanges.length === 0) { %>
            <div class="list-group-item text-muted">No related change requests.</div>
          <% } %>
          <% relatedChanges.forEach(ch => { %>
            <a href="/changes/<%= ch.id %>" class="list-group-item list-group-item-action d-flex justify-content-between">
              <span><%= ch.number %> — <%= ch.short_description %></span>
              <span class="badge bg-<%= h.CHANGE_STATUS_BADGE[ch.status] %>"><%= h.CHANGE_STATUS_LABELS[ch.status] %></span>
            </a>
          <% }) %>
        </div>
      </div>
    </div>

    <div class="col-lg-5">
      <div class="card">
        <div class="card-header fw-semibold">Relationships</div>
        <div class="list-group list-group-flush">
          <% if (relationships.length === 0) { %>
            <div class="list-group-item text-muted">No relationships defined.</div>
          <% } %>
          <% relationships.forEach(r => { %>
            <div class="list-group-item d-flex justify-content-between align-items-center">
              <div class="small">
                <% if (r.child_ci_id === ci.id) { %>
                  <strong><%= ci.name %></strong> <span class="text-muted"><%= r.relationship_type.replace('_',' ') %></span>
                  <a href="/cmdb/<%= r.parent_ci_id %>"><%= r.parent_number %> — <%= r.parent_name %></a>
                <% } else { %>
                  <a href="/cmdb/<%= r.child_ci_id %>"><%= r.child_number %> — <%= r.child_name %></a>
                  <span class="text-muted"><%= r.relationship_type.replace('_',' ') %></span> <strong><%= ci.name %></strong>
                <% } %>
              </div>
              <% if (currentUser.role !== 'user') { %>
              <form method="POST" action="/cmdb/<%= ci.id %>/relationships/<%= r.id %>/delete">
                <button class="btn btn-sm btn-outline-danger py-0 px-2"><i class="bi bi-x"></i></button>
              </form>
              <% } %>
            </div>
          <% }) %>
        </div>
        <% if (currentUser.role !== 'user') { %>
        <div class="card-body border-top">
          <form method="POST" action="/cmdb/<%= ci.id %>/relationships" class="row g-2">
            <div class="col-12">
              <label class="form-label small mb-1">This CI...</label>
              <select name="relationship_type" class="form-select form-select-sm">
                <option value="depends_on">depends on</option>
                <option value="runs_on">runs on</option>
                <option value="hosted_on">hosted on</option>
                <option value="connects_to">connects to</option>
              </select>
            </div>
            <div class="col-12">
              <select name="child_ci_id" class="form-select form-select-sm" required>
                <option value="">Select CI...</option>
                <% cis.forEach(c => { %>
                  <option value="<%= c.id %>"><%= c.ci_number %> — <%= c.name %></option>
                <% }) %>
              </select>
            </div>
            <div class="col-12">
              <button type="submit" class="btn btn-sm btn-outline-primary w-100">Add Relationship</button>
            </div>
          </form>
        </div>
        <% } %>
      </div>

      <% if (currentUser.role === 'admin') { %>
      <div class="card mt-3 border-danger">
        <div class="card-body">
          <h6 class="text-danger">Danger Zone</h6>
          <form method="POST" action="/cmdb/<%= ci.id %>/delete" onsubmit="return confirm('Delete this configuration item? This cannot be undone.');">
            <button type="submit" class="btn btn-sm btn-outline-danger w-100"><i class="bi bi-trash"></i> Delete CI</button>
          </form>
        </div>
      </div>
      <% } %>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
