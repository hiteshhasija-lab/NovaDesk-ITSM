  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script>
    // Every timestamp on the page is server-rendered as a <time datetime="...Z"> with a UTC
    // fallback (see fmtDate/fmtDateShort in helpers.js) — this re-renders each one using the
    // viewer's own system timezone, so two people in different timezones each see the correct
    // local time instead of everyone seeing the server's.
    document.querySelectorAll('time.local-datetime').forEach(function (el) {
      var d = new Date(el.getAttribute('datetime'));
      if (isNaN(d.getTime())) return;
      el.textContent = el.getAttribute('data-fmt') === 'date'
        ? d.toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' })
        : d.toLocaleString(undefined, { year: 'numeric', month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' });
    });
  </script>
</body>
</html>
