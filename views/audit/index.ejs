<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4" style="max-width: 1200px;">
  <div class="d-flex justify-content-between align-items-center mb-2">
    <h4 class="mb-0"><i class="bi bi-journal-text text-primary me-1"></i>Audit log</h4>
    <a class="btn btn-sm btn-outline-secondary" href="/settings/audit/export.csv?action=<%= encodeURIComponent(filter.action) %>&who=<%= encodeURIComponent(filter.who) %>"><i class="bi bi-download"></i> Export CSV</a>
  </div>
  <p class="text-muted small">Sign-ins and refusals, lockouts, password and two-step changes, user and role changes, API keys, webhooks and SLA settings: who did it, to what, and from which address. Entries are only ever added.</p>
  <form method="GET" action="/settings/audit" class="row g-2 mb-3">
    <div class="col-md-3"><label class="form-label small" for="audit_action">Kind of action</label>
      <input class="form-control form-control-sm" id="audit_action" name="action" list="audit-kinds" value="<%= filter.action %>" placeholder="login, user, mfa ...">
      <datalist id="audit-kinds"><% kinds.forEach(k => { %><option value="<%= k %>"></option><% }) %></datalist></div>
    <div class="col-md-4"><label class="form-label small" for="audit_who">Person (by or to)</label><input class="form-control form-control-sm" id="audit_who" name="who" value="<%= filter.who %>"></div>
    <div class="col-md-2 d-flex align-items-end"><button class="btn btn-sm btn-primary w-100" type="submit">Filter</button></div>
  </form>
  <div class="card"><div class="table-responsive">
    <table class="table table-sm table-hover align-middle mb-0">
      <thead class="table-light"><tr><th>Time</th><th>Action</th><th>By</th><th>Target</th><th>Detail</th><th>Address</th></tr></thead>
      <tbody>
        <% if (!rows.length) { %><tr><td colspan="6" class="text-center text-muted py-4">Nothing recorded<%= (filter.action || filter.who) ? ' for that filter' : ' yet' %>.</td></tr><% } %>
        <% rows.forEach(r => { %>
        <tr>
          <td class="small text-muted text-nowrap"><%- h.fmtDate(r.at) %></td>
          <td><code class="small"><%= r.action %></code></td>
          <td class="small"><%= r.actor_name || '—' %></td>
          <td class="small"><%= r.target_name || '—' %><% if (r.target_type) { %> <span class="text-muted">(<%= r.target_type %>)</span><% } %></td>
          <td class="small text-muted"><%= r.detail || '' %></td>
          <td class="small text-muted"><%= r.ip || '' %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div></div>
  <% if (pages > 1) { %>
  <nav class="mt-3 d-flex justify-content-between align-items-center small">
    <span class="text-muted"><%= total %> entries · page <%= page %> of <%= pages %></span>
    <span>
      <% if (page > 1) { %><a class="btn btn-sm btn-outline-secondary" href="/settings/audit?page=<%= page - 1 %>&action=<%= encodeURIComponent(filter.action) %>&who=<%= encodeURIComponent(filter.who) %>">&larr; Newer</a><% } %>
      <% if (page < pages) { %><a class="btn btn-sm btn-outline-secondary" href="/settings/audit?page=<%= page + 1 %>&action=<%= encodeURIComponent(filter.action) %>&who=<%= encodeURIComponent(filter.who) %>">Older &rarr;</a><% } %>
    </span>
  </nav>
  <% } %>
</div>
<%- include('../partials/foot') %>
