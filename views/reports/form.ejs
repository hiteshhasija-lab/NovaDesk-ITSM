<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-graph-up-arrow text-primary me-1"></i>Run a Report</h4>
    <a href="/reports" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to Reports</a>
  </div>

  <div class="card">
    <div class="card-body">
      <form method="POST" action="/reports/generate">
        <div class="row g-3">
          <div class="col-md-4">
            <label class="form-label fw-semibold">Time Range</label>
            <select name="range" class="form-select">
              <option value="7">Last 7 days</option>
              <option value="30" selected>Last 30 days</option>
              <option value="90">Last 90 days</option>
              <option value="365">Last 365 days</option>
            </select>
          </div>

          <div class="col-md-4">
            <label class="form-label fw-semibold">Output Format</label>
            <select name="format" class="form-select" id="reportFormatSelect">
              <option value="dashboard" selected>Dashboard (all modules)</option>
              <option value="csv">Export CSV (one module)</option>
            </select>
          </div>

          <div class="col-md-4" id="reportSourceGroup" hidden>
            <label class="form-label fw-semibold">Records to export</label>
            <select name="source" class="form-select" id="reportSourceSelect">
              <option value="incidents" selected>Incidents</option>
              <option value="changes">Changes</option>
              <option value="problems">Problems</option>
              <option value="cmdb">CMDB (Configuration Items)</option>
              <option value="requests">Service Requests</option>
            </select>
            <div class="form-text">Records created in the chosen time range.</div>
          </div>
        </div>

        <div class="mt-4 d-flex gap-2">
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> Run Report</button>
          <a href="/reports" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>
</div>
<script nonce="<%= cspNonce %>">
  (function () {
    var format = document.getElementById('reportFormatSelect');
    var group = document.getElementById('reportSourceGroup');
    function sync() { group.hidden = format.value !== 'csv'; }
    format.addEventListener('change', sync);
    sync();
  })();
</script>
<%- include('../partials/foot') %>
