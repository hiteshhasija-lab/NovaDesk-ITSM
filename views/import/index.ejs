<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4" style="max-width: 1100px;">
  <h4 class="mb-2"><i class="bi bi-upload text-primary me-1"></i>Import data</h4>
  <p class="text-muted small">Bring records in from a CSV file (a spreadsheet saved as CSV). You see what would happen to every row first, and nothing is saved until you confirm.</p>

  <div class="row g-3 mb-4">
    <% kinds.forEach(k => { %>
    <div class="col-md-4">
      <div class="card h-100"><div class="card-body d-flex flex-column">
        <h6 class="section-title"><i class="bi <%= k.icon %> me-1"></i><%= k.label %></h6>
        <p class="small text-muted flex-grow-1"><%= k.intro %></p>
        <div class="d-flex gap-2 flex-wrap">
          <a href="/import/<%= k.id %>" class="btn btn-sm btn-primary">Import a file</a>
          <a href="/import/<%= k.id %>/template.csv" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download"></i> Example file</a>
        </div>
      </div></div>
    </div>
    <% }) %>
  </div>

  <h6 class="section-title">Recent imports</h6>
  <% if (!recent.length) { %>
    <p class="small text-muted">Nothing has been imported yet.</p>
  <% } else { %>
  <div class="card"><div class="table-responsive">
    <table class="table table-sm mb-0 align-middle">
      <thead class="table-light"><tr><th>When</th><th>Who</th><th>What</th><th>File</th><th>Result</th><th></th></tr></thead>
      <tbody>
        <% recent.forEach(r => { %>
        <tr>
          <td class="small text-nowrap"><%- h.fmtDate(r.created_at) %></td>
          <td class="small"><%= r.who || '—' %></td>
          <td class="small"><%= (KINDS[r.kind] || {}).label || r.kind %><% if (r.mode === 'update') { %> <span class="badge bg-secondary">update</span><% } %></td>
          <td class="small"><%= r.filename %></td>
          <td class="small">
            <% if (r.status === 'done' && r.result) { %><%= r.result.added %> added, <%= r.result.updated %> updated<% if (r.result.rejected + r.result.failed) { %>, <span class="text-danger"><%= r.result.rejected + r.result.failed %> not imported</span><% } %>
            <% } else if (r.status === 'ready') { %><span class="badge bg-warning text-dark">waiting for you</span>
            <% } else { %><span class="badge bg-secondary"><%= r.status %></span><% } %>
          </td>
          <td><a href="/import/job/<%= r.id %>" class="btn btn-sm btn-outline-secondary">Open</a></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div></div>
  <% } %>
</div>
<%- include('../partials/foot') %>
