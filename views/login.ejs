<%- include('partials/head') %>
<div class="login-wrapper">
  <div class="login-content">
    <div class="card login-card">
    <div class="card-body px-4 px-md-5 py-3">
      <div class="text-center mb-2">
        <div class="login-logo-mark mx-auto"><img src="/img/novadesk-icon.png" alt=""></div>
        <div class="login-welcome">Welcome to</div>
        <div class="login-title">NovaDesk</div>
        <div class="login-tagline">Sign in to your account</div>
      </div>

      <% if (error) { %><div class="alert alert-danger py-2 small"><%= error %></div><% } %>

      <form method="POST" action="/login">
        <div class="login-field mb-2">
          <span class="login-field-icon"><i class="bi bi-person"></i></span>
          <input type="text" name="username" id="loginUsername" class="form-control" placeholder="Username" required autofocus>
        </div>
        <div class="login-field mb-2">
          <span class="login-field-icon"><i class="bi bi-lock"></i></span>
          <input type="password" name="password" id="loginPassword" class="form-control" placeholder="Password" required>
          <button type="button" class="login-field-toggle" id="togglePassword" aria-label="Show password"><i class="bi bi-eye"></i></button>
        </div>
        <div class="d-flex align-items-center justify-content-between mb-2">
          <div class="form-check">
            <input type="checkbox" name="remember" value="1" class="form-check-input" id="loginRemember">
            <label class="form-check-label login-remember-label" for="loginRemember">Remember me</label>
          </div>
        </div>
        <button type="submit" class="btn login-btn-primary w-100 py-2">Sign In <i class="bi bi-arrow-right ms-1"></i></button>
      </form>

      <div class="login-divider-row my-2">or</div>

      <button type="button" class="btn login-btn-sso w-100 py-2" aria-disabled="true" tabindex="-1" onclick="return false;" title="SSO is not configured for this instance">
        <i class="bi bi-building me-2"></i>Sign in with SSO
      </button>

      <div class="login-signup-row">New here? <a href="/register">Create account</a></div>

      <div class="login-trust-row">
        <span><i class="bi bi-shield-check"></i> Secure</span>
        <span class="login-trust-sep">|</span>
        <span><i class="bi bi-check-lg"></i> Compliant</span>
        <span class="login-trust-sep">|</span>
        <span><i class="bi bi-diamond"></i> Enterprise-Ready</span>
      </div>
    </div>
  </div>
  </div>
</div>
<script>
  document.getElementById('togglePassword').addEventListener('click', function () {
    var input = document.getElementById('loginPassword');
    var icon = this.querySelector('i');
    var showing = input.type === 'text';
    input.type = showing ? 'password' : 'text';
    icon.className = showing ? 'bi bi-eye' : 'bi bi-eye-slash';
    this.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
  });
</script>
<%- include('partials/foot') %>
