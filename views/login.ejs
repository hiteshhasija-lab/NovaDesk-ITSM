<%- include('partials/head') %>
<div class="login-wrapper">
  <div class="login-glow login-glow-1"></div>
  <div class="login-glow login-glow-2"></div>
  <div class="login-glow login-glow-3"></div>

  <div class="login-content">
    <div class="login-intro">
      <div class="login-intro-logo"><i class="bi bi-diagram-3-fill"></i> NovaDesk</div>
      <h1 class="login-intro-headline">One workspace. Every IT service.</h1>
      <p class="login-intro-body">Resolve incidents, fulfill requests, manage changes, and keep IT running.</p>
      <ul class="login-intro-features">
        <li><i class="bi bi-exclamation-triangle"></i> Incident &amp; Problem Management</li>
        <li><i class="bi bi-arrow-repeat"></i> Change Management</li>
        <li><i class="bi bi-hdd-stack"></i> CMDB &amp; Asset Inventory</li>
        <li><i class="bi bi-shop"></i> Self-Service Catalog &amp; Requests</li>
      </ul>
      <div class="login-intro-caption">Empower your service desk. Deliver faster resolutions.</div>
    </div>

    <div class="card login-card">
    <div class="card-body p-4 p-md-5">
      <div class="text-center mb-4">
        <div class="login-logo-mark mx-auto"><i class="bi bi-diagram-3-fill"></i></div>
        <div class="login-title">NovaDesk</div>
        <div class="login-tagline">IT Service Management</div>
      </div>

      <% if (error) { %><div class="alert alert-danger py-2 small"><%= error %></div><% } %>

      <form method="POST" action="/login">
        <div class="mb-3">
          <label class="form-label">Username</label>
          <input type="text" name="username" id="loginUsername" class="form-control" required autofocus>
        </div>
        <div class="mb-3">
          <label class="form-label">Password</label>
          <input type="password" name="password" id="loginPassword" class="form-control" required>
        </div>
        <button type="submit" class="btn btn-primary w-100 py-2">Log In</button>
      </form>

      <hr class="login-divider my-4">

      <div class="login-demo-label">Demo accounts — click to fill</div>
      <div class="login-demo-pills">
        <button type="button" class="login-demo-pill" data-user="admin" data-pass="admin123">Admin</button>
        <button type="button" class="login-demo-pill" data-user="jdoe" data-pass="agent123">Agent · Infra</button>
        <button type="button" class="login-demo-pill" data-user="bsmith" data-pass="agent123">Agent · Network</button>
        <button type="button" class="login-demo-pill" data-user="mchen" data-pass="user123">End User</button>
      </div>
    </div>
  </div>
  </div>
</div>
<script>
  document.querySelectorAll('.login-demo-pill').forEach(function (btn) {
    btn.addEventListener('click', function () {
      document.getElementById('loginUsername').value = btn.dataset.user;
      document.getElementById('loginPassword').value = btn.dataset.pass;
    });
  });
</script>
<%- include('partials/foot') %>
