<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-journal-text text-primary me-1"></i>Knowledge Base</h4>
    <% if (isStaff) { %>
    <div class="d-flex gap-2">
      <a href="/kb/export.csv<%- h.withQuery(query, { page: null }) %>" id="exportCsvBtn" class="btn btn-sm btn-outline-secondary"><i class="bi bi-download"></i> Export CSV</a>
      <a href="/kb/new" class="btn btn-sm btn-primary"><i class="bi bi-plus-lg"></i> New Article</a>
    </div>
    <% } %>
  </div>

  <form class="row g-2 mb-3" id="kbFilterForm" method="GET">
    <div class="col-md-5">
      <input type="text" id="kbLiveSearch" name="q" value="<%= filters.q || '' %>" class="form-control form-control-sm" placeholder="Search articles..." autocomplete="off">
    </div>
    <div class="col-md-3">
      <select name="category" class="form-select form-select-sm auto-filter">
        <option value="">All categories</option>
        <% categories.forEach(c => { %>
          <option value="<%= c %>" <%= filters.category === c ? 'selected' : '' %> class="text-capitalize"><%= c %></option>
        <% }) %>
      </select>
    </div>
    <div class="col-md-2">
      <select name="sort" class="form-select form-select-sm auto-filter">
        <option value="recent" <%= filters.sort === 'recent' ? 'selected' : '' %>>Recently Updated</option>
        <option value="title" <%= filters.sort === 'title' ? 'selected' : '' %>>Title A-Z</option>
        <option value="views" <%= filters.sort === 'views' ? 'selected' : '' %>>Most Viewed</option>
      </select>
    </div>
    <div class="col-md-2">
      <button class="btn btn-sm btn-outline-secondary w-100" type="submit">Go</button>
    </div>
  </form>
  <div class="row g-3" id="kbArticleGrid">
    <% articles.forEach(a => { %>
      <div class="col-md-6 kb-article-card" data-search="<%= [a.title, a.body].filter(Boolean).join(' ').toLowerCase() %>">
        <a href="/kb/<%= a.id %>" class="text-decoration-none">
          <div class="card h-100 tile-card">
            <div class="card-body">
              <div class="d-flex justify-content-between align-items-start">
                <h6 class="fw-semibold mb-1"><%= a.title %></h6>
                <% if (a.status === 'draft') { %><span class="badge bg-secondary ms-2">Draft</span><% } %>
              </div>
              <div class="small text-muted mb-2"><%= a.number %> · <span class="text-capitalize"><%= a.category %></span> · by <%= a.author_name || 'Unknown' %></div>
              <p class="small text-muted mb-0"><%= a.body.replace(/\n/g,' ').slice(0, 140) %>…</p>
            </div>
            <div class="card-footer small text-muted d-flex justify-content-between">
              <span><i class="bi bi-eye"></i> <%= a.view_count %> views</span>
              <span>Updated <%- h.fmtDateShort(a.updated_at) %></span>
            </div>
          </div>
        </a>
      </div>
    <% }) %>
    <% if (articles.length === 0) { %>
      <div class="col-12 text-muted text-center py-5" id="kbNoResults">No articles found.</div>
    <% } %>
  </div>
  <%- include('../partials/pagination', { pagination, query }) %>
</div>

<script>
  document.querySelectorAll('#kbFilterForm .auto-filter').forEach(function (el) {
    el.addEventListener('change', function () { el.form.submit(); });
  });

  (function () {
    var input = document.getElementById('kbLiveSearch');
    var form = document.getElementById('kbFilterForm');
    var exportBtn = document.getElementById('exportCsvBtn');
    if (!input) return;

    if (exportBtn) {
      var baseHref = exportBtn.getAttribute('href').split('?')[0];
      var updateHref = function () {
        var params = new URLSearchParams(window.location.search);
        var q = input.value.trim();
        if (q) { params.set('q', q); } else { params.delete('q'); }
        params.delete('page');
        var qs = params.toString();
        exportBtn.setAttribute('href', baseHref + (qs ? '?' + qs : ''));
      };
      input.addEventListener('input', updateHref);
    }

    // Debounced auto-submit — searches the full dataset server-side (every page, not just the
    // cards already rendered on this one), instead of the old behavior of hiding/showing
    // already-rendered cards client-side, which silently missed matches sitting on another page.
    if (form) {
      var searchTimer = null;
      input.addEventListener('input', function () {
        clearTimeout(searchTimer);
        searchTimer = setTimeout(function () { form.submit(); }, 400);
      });
    }
  })();
</script>
<%- include('../partials/foot') %>
