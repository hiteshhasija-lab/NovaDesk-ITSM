<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-start mb-3">
    <div>
      <h4 class="mb-0"><%= article.title %> <% if (article.status === 'draft') { %><span class="badge bg-secondary ms-2">Draft</span><% } %></h4>
      <div class="text-muted small"><%= article.number %> · <span class="text-capitalize"><%= article.category %></span> · by <%= article.author_name || 'Unknown' %> · Updated <%= h.fmtDateShort(article.updated_at) %> · <i class="bi bi-eye"></i> <%= article.view_count %> views</div>
    </div>
    <div class="d-flex gap-2">
      <% if (currentUser.role !== 'user') { %>
      <a href="/kb/<%= article.id %>/edit" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i> Edit</a>
      <% } %>
      <a href="/kb" class="btn btn-sm btn-outline-secondary">&larr; Back</a>
    </div>
  </div>

  <div class="card" style="max-width:760px;">
    <div class="card-body">
      <div style="line-height:1.7;"><%- h.escapeHtml(article.body).replace(/\n/g, '<br>') %></div>
    </div>
  </div>

  <% if (currentUser.role === 'admin') { %>
  <div class="card mt-3 border-danger" style="max-width:760px;">
    <div class="card-body">
      <h6 class="text-danger">Danger Zone</h6>
      <form method="POST" action="/kb/<%= article.id %>/delete" onsubmit="return confirm('Delete this article? This cannot be undone.');">
        <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i> Delete Article</button>
      </form>
    </div>
  </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
