<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <h4 class="mb-3"><i class="bi bi-people text-secondary me-1"></i><%= user ? 'Edit User' : 'New User' %></h4>
  <div class="card" style="max-width:600px;">
    <div class="card-body">
      <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
      <form method="POST" action="<%= user && user.id ? '/users/' + user.id + '/update' : '/users' %>">
        <div class="row g-3">
          <div class="col-md-6">
            <label class="form-label">Full Name *</label>
            <input type="text" name="full_name" class="form-control" value="<%= user ? user.full_name : '' %>" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Username *</label>
            <input type="text" name="username" class="form-control" value="<%= user ? user.username : '' %>" required>
          </div>
          <div class="col-md-6">
            <label class="form-label">Email</label>
            <input type="email" name="email" class="form-control" value="<%= user ? (user.email||'') : '' %>">
          </div>
          <div class="col-md-6">
            <label class="form-label">Department</label>
            <input type="text" name="department" class="form-control" value="<%= user ? (user.department||'') : '' %>">
          </div>
          <div class="col-12">
            <label class="form-label">Assignment groups</label>
            <div class="row g-1">
              <% (typeof groups !== 'undefined' ? groups : []).forEach(g => { %>
              <div class="col-md-3 col-sm-4 col-6">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" name="groups" value="<%= g %>" id="grp_<%= g.replace(/[^A-Za-z0-9]/g, '_') %>" <%= (typeof userGroups !== 'undefined' && userGroups.includes(g)) ? 'checked' : '' %>>
                  <label class="form-check-label small" for="grp_<%= g.replace(/[^A-Za-z0-9]/g, '_') %>"><%= g %></label>
                </div>
              </div>
              <% }) %>
            </div>
            <div class="form-text">Members of IRO-Build/Decom can approve decommission requests (so can the person who requested one).</div>
          </div>
          <div class="col-md-6">
            <label class="form-label">Role</label>
            <select name="role" class="form-select">
              <% ['admin','agent','user'].forEach(r => { %>
                <option value="<%= r %>" <%= user && user.role === r ? 'selected' : '' %>><%= r[0].toUpperCase()+r.slice(1) %></option>
              <% }) %>
            </select>
          </div>
          <div class="col-md-6">
            <label class="form-label"><%= user && user.id ? 'Reset Password' : 'Password' %></label>
            <input type="password" name="password" class="form-control" placeholder="<%= user && user.id ? 'Leave blank to keep current' : '' %>" <%= user && user.id ? '' : 'required' %>>
          </div>
          <% if (user && user.id) { %>
          <div class="col-12">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="active" id="active" <%= user.active ? 'checked' : '' %>>
              <label class="form-check-label" for="active">Active</label>
            </div>
          </div>
          <% } %>
        </div>
        <div class="mt-4">
          <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg"></i> <%= user && user.id ? 'Save Changes' : 'Create User' %></button>
          <a href="/users" class="btn btn-outline-secondary">Cancel</a>
        </div>
      </form>
    </div>
  </div>

  <% if (user && user.id && mfaStatus) { %>
  <div class="card mt-3" style="max-width:700px;">
    <div class="card-body">
      <h6 class="section-title">Sign-in security</h6>
      <% if (resetMessage) { %><div class="alert alert-success py-2 small"><%= resetMessage %></div><% } %>
      <dl class="row mb-2 small">
        <dt class="col-sm-4">Two-step verification</dt>
        <dd class="col-sm-8"><%= mfaStatus.enabled ? 'On' : (mfaStatus.pending ? 'Set-up started, not finished' : 'Off') %></dd>
        <dt class="col-sm-4">Single sign-on</dt>
        <dd class="col-sm-8"><% if (identities.length) { %><% identities.forEach(i => { %><div><%= i.issuer %><% if (i.email) { %> <span class="text-muted">(<%= i.email %>)</span><% } %></div><% }) %><% } else { %>Not linked<% } %></dd>
      </dl>
      <dl class="row mb-2 small"><dt class="col-sm-4">API keys</dt><dd class="col-sm-8"><%= apiKeyCount %> active</dd></dl>
      <% if (apiKeyCount) { %>
      <form method="POST" action="/users/<%= user.id %>/api-keys/revoke" class="m-0 mb-2"><button type="submit" class="btn btn-outline-danger btn-sm">Revoke all API keys</button> <span class="small text-muted ms-2">For a leaked key, or someone who is leaving.</span></form>
      <% } %>
      <% if (mfaStatus.enabled || mfaStatus.pending) { %>
      <form method="POST" action="/users/<%= user.id %>/mfa/reset" class="m-0"><button type="submit" class="btn btn-outline-danger btn-sm">Reset two-step verification</button> <span class="small text-muted ms-2">For someone who lost their phone and recovery codes.</span></form>
      <% } %>
    </div>
  </div>
  <% } %>
</div>
<%- include('../partials/foot') %>
