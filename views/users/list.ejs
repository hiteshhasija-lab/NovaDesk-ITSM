<%- include('../partials/head') %>
<%- include('../partials/nav') %>
<div class="container-fluid px-4 py-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-people text-secondary me-1"></i>Users</h4>
    <div class="d-flex gap-2">
      <a href="/import/users" class="btn btn-sm btn-outline-secondary"><i class="bi bi-upload"></i> Import CSV</a>
      <a href="/users/new" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg"></i> New User</a>
    </div>
  </div>
  <div class="card">
    <div class="table-responsive">
      <table class="table table-hover mb-0 align-middle">
        <thead class="table-light">
          <tr><th>Name</th><th>Username</th><th>Email</th><th>Role</th><th>Department</th><th>Assignment groups</th><th>Active</th><th></th></tr>
        </thead>
        <tbody>
          <% users.forEach(u => { %>
          <tr>
            <td><%= u.full_name %><% if (u.anonymised_at) { %> <span class="badge bg-dark ms-1" title="Anonymised: nothing that says who they were is kept.">anonymised</span><% } %><% if (u.scim_managed) { %> <span class="badge bg-info text-dark ms-1" title="Created or changed by your identity provider (SCIM). Changes made here may be overwritten at its next sync.">SCIM</span><% } %><% if (u.created_from_email) { %> <span class="badge bg-secondary ms-1" title="Made when they first emailed the help desk. They cannot sign in until a password is set for them or they use single sign-on.">email contact</span><% } %></td>
            <td><%= u.username %></td>
            <td><%= u.email || '—' %></td>
            <td><span class="badge bg-<%= u.role === 'admin' ? 'danger' : u.role === 'agent' ? 'primary' : 'secondary' %> text-capitalize"><%= u.role %></span></td>
            <td><%= u.department || '—' %></td>
            <td class="small"><%= ((typeof groupsByUser !== 'undefined' && groupsByUser[u.id]) || []).join(', ') || '—' %></td>
            <td><%- u.active ? '<i class="bi bi-check-circle text-success"></i>' : '<i class="bi bi-x-circle text-muted"></i>' %></td>
            <td class="text-nowrap">
              <a href="<%= u.anonymised_at ? '/privacy/person/' + u.id : '/users/' + u.id + '/edit' %>" class="btn btn-sm btn-outline-secondary"><%= u.anonymised_at ? 'Privacy' : 'Edit' %></a>
              <% if (currentUser && u.id !== currentUser.id) { %>
              <form method="POST" action="/users/<%= u.id %>/delete" class="d-inline" data-confirm="Delete user &quot;<%= u.username %>&quot;? This cannot be undone.">
                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
              </form>
              <% } %>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</div>
<%- include('../partials/foot') %>
